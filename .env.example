# Copied to .env.local (gitignored) for local scripts only. Never commit
# real values. See docs/implementation-log.md Phase 2 entry for exactly
# where each of these actually lives (this file documents names only).

# --- Public / client-safe (Astro PUBLIC_ prefix convention) -------------
# Safe to expose to the browser: the anon key is designed for this and is
# meaningless without RLS policies behind it. Not used by anything yet in
# this codebase — documented here ahead of the Phase 3 public site work.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only — used by scripts/migration/*.mjs, run locally by a --
# --- human, NEVER in CI, NEVER referenced from client code ------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS entirely. Must never appear in client code,
# committed files, logs, screenshots, or a generated browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Public / client-safe — read by src/scripts/turnstile-widget.ts to
# --- render the Turnstile challenge widget. Sitekeys are designed to be
# --- public (unlike the secret key below). Currently unset everywhere,
# --- so the widget never renders — see docs/planning/resend-turnstile-
# --- setup.md for the exact account-creation/deploy steps.
PUBLIC_TURNSTILE_SITE_KEY=

# --- Worker-only secrets — set as Cloudflare secrets (`wrangler secret
# --- put <NAME> --config wrangler.jsonc`), never in this file or any
# --- committed config, never referenced from client code. Read via
# --- `import { env } from 'cloudflare:workers'` in src/pages/api/
# --- contact.ts and checkout.ts. All three below must be set together —
# --- see src/pages/api/contact.ts's file comment: the routes only
# --- activate once Resend AND Turnstile are both configured, and stay in
# --- their honest "not configured" 503 state otherwise.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
TURNSTILE_SECRET_KEY=
