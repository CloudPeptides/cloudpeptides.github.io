---
/**
 * Error state — design handoff §29: "Specific message, never a raw
 * exception string; preserves user input/filters; offers Retry."
 */
interface Props {
  message?: string;
  retryHref?: string;
}
const { message = 'Something went wrong loading this content.', retryHref } = Astro.props;
---

<div class="cp-error-state" role="alert">
  <p>{message}</p>
  {
    retryHref && (
      <a class="cp-error-state__retry" href={retryHref}>
        Retry
      </a>
    )
  }
</div>

<style>
  .cp-error-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
    padding: 3rem 1.5rem;
    border: 1.5px solid var(--danger-text);
    border-radius: var(--radius-card);
    background: var(--bg-elevated);
    color: var(--text-primary);
  }
  .cp-error-state__retry {
    color: var(--primary);
    font-weight: 500;
    text-decoration: underline;
  }
</style>
