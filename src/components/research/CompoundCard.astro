---
/**
 * Compound directory result card — design handoff §27, visually matching
 * design-concepts/cloudpeptides_directory_concept.html: content-specific
 * icon, Fraunces name, mono alias line, entity/category badges.
 *
 * Favorite/Compare actions from the concept are intentionally omitted —
 * they're Phase 5 (auth) features with no real persistence yet, and this
 * codebase's standing policy (see git history) is to never stub fake
 * interactivity.
 *
 * Phase 3: now that listPublishedCompounds() computes real evidence
 * aggregates (see src/lib/supabase.ts), the card surfaces a compact
 * evidence-strength indicator and, for any compound with a real
 * expert_review_flag_reason set (Research CMS gap-fill, 2026-08-10 —
 * a genuine admin-editable column, no longer the old hardcoded
 * src/lib/expert-review-flags.ts list), a review-flagged badge —
 * satisfying the directory's "evidence and expert-review warnings"
 * requirement without duplicating the full profile-page evidence
 * breakdown.
 *
 * No blanket compound-level identity_confidence or research_review_
 * status badge (2026-08-10 correction) — both fields still exist and
 * are admin-editable (src/pages/admin/compounds/[id].astro), but a
 * badge that read "unverified" for literally every compound (nobody
 * had ever promoted identity_confidence away from its default) was a
 * misleading blanket signal, and a "Research reviewed" badge invited
 * the same misreading in the other direction. The public research
 * stands on its citations and claim-level evidence instead; a real,
 * specific concern about a compound still surfaces here via
 * expert_review_flag_reason's "Review flagged" badge above, never via
 * a generic per-field state badge.
 *
 * Equal-height grid (2026-08-20, approved): every region below (icon
 * row, title, alias, badges, evidence footer) gets an explicit CSS
 * `height` — never `min-height` — so a short card can't shrink and a
 * long card can't grow; the card's total height is just the fixed sum
 * of its regions, identical on every card regardless of its own
 * content or its position in the grid (not just within one grid row,
 * which `align-items: stretch` would already give for free — the
 * actual bug being fixed). Title/alias overflow via 2-line
 * `-webkit-line-clamp`, never font-shrinking. The alias paragraph is
 * now unconditionally rendered (even when a compound has none) so
 * that region's height is reserved on every card, not just the ones
 * with aliases — the same reasoning applies to a card with only one
 * category badge vs. two: the badges region always reserves 2 rows.
 */
import type { CompoundListItem } from '../../lib/supabase';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import { EVIDENCE_QUALITY_LABELS } from '../../lib/evidence';

interface Props {
  compound: CompoundListItem;
}
const { compound } = Astro.props;

const ENTITY_LABELS: Record<string, string> = {
  peptide: 'Peptide',
  peptide_blend: 'Peptide blend',
  stack: 'Stack',
  small_molecule_drug: 'Small molecule',
  biologic: 'Biologic',
  supplement: 'Supplement',
  non_peptide_research_compound: 'Research compound',
};

// 1.5px stroke, rounded caps/joins, 20px grid — design handoff §18.
// Content-specific per entity_kind — never the brand mark (§19).
const ENTITY_ICONS: Record<string, string> = {
  peptide: '<path d="M8 3h4M8.5 3v5l-4 8a1.5 1.5 0 0 0 1.3 2.2h8.4A1.5 1.5 0 0 0 15.5 16l-4-8V3"/>',
  peptide_blend:
    '<circle cx="7" cy="7" r="3"/><circle cx="13" cy="13" r="3"/><path d="M9.2 9.2l1.6 1.6"/>',
  stack: '<path d="M10 3 3 7l7 4 7-4-7-4Z"/><path d="M3 11l7 4 7-4M3 15l7 4 7-4"/>',
  small_molecule_drug:
    '<circle cx="6" cy="6" r="2"/><circle cx="14" cy="6" r="2"/><circle cx="10" cy="13" r="2"/><path d="M7.5 7.5l1.8 4M12.5 7.5l-1.8 4"/>',
  biologic: '<path d="M10 3c-3 2-5 5-5 8a5 5 0 0 0 10 0c0-3-2-6-5-8Z"/><path d="M10 9v6"/>',
  supplement: '<circle cx="10" cy="10" r="7"/><path d="M10 6v4l3 2"/>',
  non_peptide_research_compound:
    '<circle cx="10" cy="10" r="2.2"/><path d="M10 3v2.2M10 14.8V17M17 10h-2.2M5.2 10H3"/>',
};
const icon = ENTITY_ICONS[compound.entity_kind] ?? ENTITY_ICONS.non_peptide_research_compound;
const isReviewFlagged = Boolean(compound.expert_review_flag_reason);
const aliasText = compound.compound_aliases.map((a) => a.alias).join(', ');
const displayName = compound.display_name || compound.name;
---

<a href={`/research/compounds/${compound.slug}`} class="cp-compound-card-link">
  <Card
    class="cp-compound-card"
    accent={compound.entity_kind === 'stack' ? 'var(--terracotta-text)' : 'var(--primary)'}
  >
    <div class="cp-compound-card__top">
      <svg
        class="cp-compound-card__icon"
        aria-hidden="true"
        viewBox="0 0 20 20"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        set:html={icon}
      />
      <div class="cp-compound-card__top-badges">
        {isReviewFlagged && <Badge tone="danger">Review flagged</Badge>}
      </div>
    </div>
    <h2 class="cp-compound-card__name" title={displayName}>
      {displayName}
    </h2>
    <p class="cp-compound-card__alias" title={aliasText || undefined}>
      {aliasText && <>aka {aliasText}</>}
    </p>
    <div class="cp-compound-card__badges">
      <Badge tone={compound.entity_kind === 'stack' ? 'terracotta' : 'forest'}>
        {ENTITY_LABELS[compound.entity_kind] ?? compound.entity_kind}
      </Badge>
      {compound.category && <Badge tone="neutral">{compound.category}</Badge>}
    </div>
    <div class="cp-compound-card__evidence-strip">
      <span>
        {
          compound.maxEvidenceQuality
            ? `${EVIDENCE_QUALITY_LABELS[compound.maxEvidenceQuality]} evidence`
            : 'Not yet assessed'
        }
      </span>
      <span aria-hidden="true">·</span>
      <span>{compound.studyCount} {compound.studyCount === 1 ? 'source' : 'sources'}</span>
      {
        compound.hasHumanEvidence && (
          <>
            <span aria-hidden="true">·</span>
            <span>Human evidence</span>
          </>
        )
      }
    </div>
  </Card>
</a>

<style>
  .cp-compound-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    /* Grid rows still stretch this link to the row's tallest item
       (harmless — the card's own fixed-height regions below are what
       actually guarantee equal height across the whole grid, not just
       one row) — height: 100% just lets .cp-card fill whatever the
       link box ends up being rather than leaving a gap. */
    height: 100%;
  }
  .cp-compound-card :global(.cp-card__body) {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  /* Every region below reserves a fixed `height` (never `min-height`)
     — a card with less content doesn't shrink, a card with more
     content can't grow; overflow is always clipped, never spilled
     outside the card. Identical values at every breakpoint by design:
     line-clamping already adapts to whatever width the card actually
     has, so one set of reserved heights is correct everywhere rather
     than needing separate desktop/tablet/mobile numbers. */

  .cp-compound-card__top {
    height: 1.75rem;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
    overflow: hidden;
  }
  .cp-compound-card__top-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.375rem;
  }
  .cp-compound-card__icon {
    color: var(--primary);
    flex-shrink: 0;
  }

  .cp-compound-card__name {
    height: 3.1rem; /* 2 lines at 1.1875rem / 1.3 line-height */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: break-word;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1875rem;
    line-height: 1.3;
    margin: 0;
    color: var(--text-primary);
  }

  .cp-compound-card__alias {
    /* Unconditionally rendered (see the .astro file) so this region is
       reserved even when a compound has no alias — a short card must
       not end up shorter than one with a two-line alias. */
    height: 2.3rem; /* 2 lines at 0.8125rem / 1.4 line-height */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: break-word;
    margin: 0;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .cp-compound-card__badges {
    height: 3.9rem; /* reserves 2 full badge rows, whether 0, 1, or 2 are used */
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 0.4rem;
    overflow: hidden;
  }

  .cp-compound-card__evidence-strip {
    height: 2.6rem; /* border + padding-top + up to 2 wrapped lines */
    box-sizing: border-box;
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 0.375rem;
    padding-top: 0.625rem;
    border-top: 1px solid var(--border-subtle);
    overflow: hidden;
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--text-muted);
  }

  /* prefers-reduced-motion is handled globally (Card's own hover
     shadow transition already respects it via the site-wide media
     query in src/styles) — no per-card override needed here. */
</style>
