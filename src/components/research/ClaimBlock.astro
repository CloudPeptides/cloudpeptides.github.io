---
/**
 * One claim, rendered with its interpretation badge and citation chips
 * — design handoff §28: "claim-level statements, each with its own
 * evidence-type + evidence-quality badges — never a single uncited
 * paragraph." Evidence-quality + rationale is available on click-through
 * (a <details> disclosure here) rather than shown as a third badge by
 * default, per §20.
 *
 * Reconciliation-aware (Phase 3 closeout): a claim whose quality_rationale
 * carries a "[Reconciliation …, disposition: revised]" marker (see
 * src/lib/reconciliation.ts) gets its correction rendered prominently,
 * ABOVE the fold, not tucked in the collapsed evidence-quality disclosure
 * — this is what "revised claims display the corrected version" means in
 * practice: the correction is the first thing a reader sees, with the
 * original legacy wording clearly labeled and visually subordinated
 * underneath it. Claims with a 'supported' disposition (the vast
 * majority of reconciled legacy claims) render exactly like any other
 * claim — their rationale is still reachable via the same click-through
 * disclosure as always, no different treatment needed since nothing
 * about them needs correcting.
 *
 * This component never renders an 'unsupported'/'contradicted' claim —
 * the profile page filters those out before they ever reach here (see
 * partitionClaimsByDisposition) and routes them to the dedicated "not
 * independently verified" section instead (UnsupportedClaimsCard.astro).
 * The guard below is defense-in-depth, not the primary mechanism.
 */
import type { Claim, ClaimSource, Source } from '../../lib/database.types';
import EvidenceBadge from './EvidenceBadge.astro';
import InterpretationBadge from './InterpretationBadge.astro';
import { parseReconciliation } from '../../lib/reconciliation';

interface Props {
  claim: Claim & { claim_sources: (ClaimSource & { sources: Source })[] };
}
const { claim } = Astro.props;

const reconciliation = parseReconciliation(claim.quality_rationale);
const isRevised = reconciliation?.disposition === 'revised';
// Defense-in-depth only — the caller is responsible for never passing an
// unsupported/contradicted claim here at all.
const isHidden =
  reconciliation?.disposition === 'unsupported' || reconciliation?.disposition === 'contradicted';
---

{
  !isHidden && (
    <article class="cp-claim" data-disposition={reconciliation?.disposition}>
      {isRevised && reconciliation && (
        <div class="cp-claim__correction">
          <p class="cp-claim__correction-label">
            <svg
              aria-hidden="true"
              viewBox="0 0 20 20"
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M4 10.5l3.5 3.5L16 5" />
            </svg>
            Editorial correction
          </p>
          <p class="cp-claim__correction-text">{reconciliation.rationale}</p>
        </div>
      )}
      <p class="cp-claim__statement" data-original-wording={isRevised ? '' : undefined}>
        {isRevised && <span class="cp-claim__original-label">Original wording:</span>}{' '}
        {claim.statement}
      </p>
      <div class="cp-claim__meta">
        {claim.interpretation_status && (
          <InterpretationBadge status={claim.interpretation_status} />
        )}
        {claim.claim_sources.map(({ sources }) => (
          <EvidenceBadge
            sourceType={sources.source_type}
            studyDesign={sources.studies?.study_design}
          />
        ))}
      </div>
      {claim.evidence_quality && claim.quality_rationale && !isRevised && (
        <details class="cp-claim__quality">
          <summary>Evidence quality: {claim.evidence_quality.replace('_', ' ')}</summary>
          <p>{reconciliation ? reconciliation.rationale : claim.quality_rationale}</p>
        </details>
      )}
      {claim.claim_sources.length > 0 && (
        <ul class="cp-claim__sources">
          {claim.claim_sources.map(({ sources, relationship }) => (
            <li>
              <a href={sources.url} target="_blank" rel="noopener noreferrer">
                {sources.title}
              </a>
              <span class="cp-claim__relationship">({relationship.replace(/_/g, ' ')})</span>
            </li>
          ))}
        </ul>
      )}
    </article>
  )
}

<style>
  .cp-claim {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .cp-claim:last-child {
    border-bottom: none;
  }
  .cp-claim__correction {
    background: var(--accent-mint);
    border: 1px solid var(--secondary);
    border-radius: var(--radius-control);
    padding: 0.75rem 0.875rem;
    margin-bottom: 0.75rem;
  }
  .cp-claim__correction-label {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0 0 0.375rem;
    font-weight: 600;
    font-size: var(--text-caption);
    color: var(--primary);
  }
  .cp-claim__correction-text {
    margin: 0;
    color: var(--text-primary);
    line-height: var(--text-body--line-height);
  }
  .cp-claim__statement {
    margin: 0 0 0.75rem;
    color: var(--text-primary);
    line-height: var(--text-body--line-height);
  }
  .cp-claim__statement[data-original-wording] {
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }
  .cp-claim__original-label {
    font-size: var(--text-caption);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }
  .cp-claim__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .cp-claim__quality {
    font-size: var(--text-caption);
    color: var(--text-secondary);
    margin: 0.5rem 0;
  }
  .cp-claim__quality summary {
    cursor: pointer;
    font-weight: 500;
  }
  .cp-claim__quality p {
    margin: 0.375rem 0 0;
  }
  .cp-claim__sources {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    font-size: var(--text-caption);
    font-family: var(--font-mono);
  }
  .cp-claim__sources a {
    color: var(--info-text);
  }
  .cp-claim__relationship {
    color: var(--text-muted);
    margin-left: 0.25rem;
  }
</style>
