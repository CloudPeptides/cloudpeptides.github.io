---
/**
 * Evidence-type badge — design handoff §20: "neutral gray-green badge,
 * one icon per type — human (person), animal (paw), in-vitro (flask),
 * mechanistic (atom/gear), regulatory (seal), anecdotal (outlined
 * speech-bubble, visually distinct as 'not a study')."
 *
 * Our schema's granular source_type/study_design values are mapped down
 * to this simplified display taxonomy. `sourceType`/`studyDesign` come
 * straight from the claim's linked source — nothing here infers or
 * upgrades evidence type from anything else (Blueprint v2 §5: evidence
 * type is objective provenance, never a judgment call).
 */
import type { SourceType, StudyDesign } from '../../lib/database.types';

interface Props {
  sourceType?: SourceType;
  studyDesign?: StudyDesign | null;
  class?: string;
}
const { sourceType, studyDesign, class: className } = Astro.props;

type DisplayType =
  | 'human'
  | 'animal'
  | 'in-vitro'
  | 'mechanistic'
  | 'regulatory'
  | 'anecdotal'
  | 'database'
  | 'review'
  | 'other';

function resolveDisplayType(): DisplayType {
  if (studyDesign) {
    if (
      [
        'rct_human',
        'non_randomized_human_trial',
        'human_observational',
        'case_report_or_series',
      ].includes(studyDesign)
    )
      return 'human';
    if (studyDesign === 'animal_study') return 'animal';
    if (studyDesign === 'in_vitro_study') return 'in-vitro';
    if (studyDesign === 'mechanistic') return 'mechanistic';
    if (['systematic_review', 'meta_analysis', 'narrative_review'].includes(studyDesign))
      return 'review';
  }
  if (sourceType === 'anecdotal_report') return 'anecdotal';
  if (
    sourceType === 'fda_document' ||
    sourceType === 'ema_document' ||
    sourceType === 'wada_list' ||
    sourceType === 'regulatory_announcement'
  )
    return 'regulatory';
  if (
    sourceType === 'official_database_record' ||
    sourceType === 'pubchem_record' ||
    sourceType === 'uniprot_record'
  )
    return 'database';
  return 'other';
}

const displayType = resolveDisplayType();

const LABELS: Record<DisplayType, string> = {
  human: 'Human',
  animal: 'Animal',
  'in-vitro': 'In-vitro',
  mechanistic: 'Mechanistic',
  regulatory: 'Regulatory',
  anecdotal: 'Anecdotal (not a study)',
  database: 'Database record',
  review: 'Review',
  other: 'Other source',
};

// 1.5px stroke, rounded caps/joins, 20px grid — design handoff §18.
const ICONS: Record<DisplayType, string> = {
  human: '<circle cx="10" cy="6" r="3"/><path d="M4 17c0-3.3 2.7-6 6-6s6 2.7 6 6"/>',
  animal:
    '<circle cx="6" cy="6" r="1.6"/><circle cx="14" cy="6" r="1.6"/><circle cx="3.5" cy="10.5" r="1.6"/><circle cx="16.5" cy="10.5" r="1.6"/><path d="M10 10c-2.5 0-4.5 2-4.5 4.2 0 1.6 1.4 2.8 3 2.4.7-.2 1-.2 1.5-.2s.8 0 1.5.2c1.6.4 3-.8 3-2.4C14.5 12 12.5 10 10 10Z"/>',
  'in-vitro':
    '<path d="M8 3h4M8.5 3v5l-4 8a1.5 1.5 0 0 0 1.3 2.2h8.4A1.5 1.5 0 0 0 15.5 16l-4-8V3"/><path d="M6.5 13h7"/>',
  mechanistic:
    '<circle cx="10" cy="10" r="2.2"/><path d="M10 3v2.2M10 14.8V17M17 10h-2.2M5.2 10H3M15.1 4.9l-1.5 1.5M6.4 13.6l-1.5 1.5M15.1 15.1l-1.5-1.5M6.4 6.4 4.9 4.9"/>',
  regulatory:
    '<path d="M10 3 4 5.5v4c0 4 2.6 7 6 8 3.4-1 6-4 6-8v-4L10 3Z"/><path d="M7.5 10l1.8 1.8 3.2-3.6"/>',
  anecdotal:
    '<path d="M3 5.5A1.5 1.5 0 0 1 4.5 4h11A1.5 1.5 0 0 1 17 5.5v6A1.5 1.5 0 0 1 15.5 13H9l-3.5 3v-3H4.5A1.5 1.5 0 0 1 3 11.5v-6Z"/>',
  database:
    '<ellipse cx="10" cy="5" rx="6" ry="2.2"/><path d="M4 5v10c0 1.2 2.7 2.2 6 2.2s6-1 6-2.2V5M4 10c0 1.2 2.7 2.2 6 2.2s6-1 6-2.2"/>',
  review:
    '<path d="M5 3.5h7.5L17 8v8.5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-12a1 1 0 0 1 1-1Z"/><path d="M12 3.5V8h4.5M7 11h6M7 14h4"/>',
  other:
    '<circle cx="10" cy="10" r="7"/><path d="M10 13v.01M10 6.5a2 2 0 0 1 2 2c0 1.3-2 1.8-2 3.5"/>',
};
---

<span class:list={['cp-evidence-badge', className]} data-evidence-type={displayType}>
  <svg
    aria-hidden="true"
    viewBox="0 0 20 20"
    width="14"
    height="14"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    set:html={ICONS[displayType]}
  />
  {LABELS[displayType]}
</span>

<style>
  .cp-evidence-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: 500;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    background: var(--bg-sunken);
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
  }
  .cp-evidence-badge[data-evidence-type='anecdotal'] {
    font-style: italic;
  }
</style>
