---
/**
 * Dedicated, clearly-labeled section for claims that cannot be shown as
 * ordinarily supported: either a reconciliation pass classified them
 * 'unsupported'/'contradicted' (defensively — none currently exist in
 * the database, see docs/enrichment/full-coverage-report.md), or the
 * only citation they had turned out to be the retired legacy site,
 * which isn't evidence (src/lib/evidence.ts's isLegacySiteSource,
 * 2026-08-11). This is the ONLY place these claims are ever allowed to
 * appear — the profile page filters them out of every normal content
 * section before this component is reached
 * (src/lib/reconciliation.ts's partitionClaimsByDisposition). No
 * InterpretationBadge is rendered here (that badge implies a scientific
 * interpretation confidence level, which is exactly what these claims
 * lack) and no citation chips are shown as if they "support" the
 * statement — the whole point of this section is to make clear these
 * are not established, independently-verified facts.
 */
import type { Claim } from '../../lib/database.types';
import Card from '../ui/Card.astro';
import { parseReconciliation } from '../../lib/reconciliation';

interface Props {
  claims: Claim[];
}
const { claims } = Astro.props;
---

{
  claims.length > 0 && (
    <Card class="cp-unsupported-card">
      <h2 class="cp-unsupported-card__heading">
        <svg
          aria-hidden="true"
          viewBox="0 0 20 20"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M10 3 4 5.5v4c0 4 2.6 7 6 8 3.4-1 6-4 6-8v-4L10 3Z" />
          <path d="M10 8v3.5M10 14v.01" />
        </svg>
        Claims not currently independently verified
      </h2>
      <p class="cp-unsupported-card__intro">
        The statements below could not be independently verified against an authoritative source —
        either a dedicated scientific reconciliation pass couldn't confirm them, or they have no
        remaining citation strong enough to count as evidence. That does not mean they are known to
        be false, only that they are not currently established. They are preserved here, clearly
        labeled, for transparency — never as confirmed research findings.
      </p>
      <ul class="cp-unsupported-list">
        {claims.map((claim) => {
          const reconciliation = parseReconciliation(claim.quality_rationale);
          return (
            <li class="cp-unsupported-item">
              <p class="cp-unsupported-item__statement">{claim.statement}</p>
              {reconciliation && (
                <p class="cp-unsupported-item__note">{reconciliation.rationale}</p>
              )}
            </li>
          );
        })}
      </ul>
    </Card>
  )
}

<style>
  .cp-unsupported-card {
    margin-bottom: 1.25rem;
    border-color: var(--warning-text);
    border-width: 1.5px;
    background: color-mix(in srgb, var(--warning-text) 6%, var(--bg-elevated));
  }
  .cp-unsupported-card__heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-h3);
    color: var(--warning-text);
    margin: 0 0 0.75rem;
  }
  .cp-unsupported-card__heading svg {
    flex-shrink: 0;
  }
  .cp-unsupported-card__intro {
    color: var(--text-secondary);
    line-height: var(--text-body--line-height);
    margin: 0 0 1rem;
    font-size: var(--text-caption);
  }
  .cp-unsupported-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .cp-unsupported-item {
    padding: 0.75rem 0.875rem;
    background: var(--bg-sunken);
    border-radius: var(--radius-control);
    border: 1px solid var(--border-subtle);
  }
  .cp-unsupported-item__statement {
    margin: 0 0 0.375rem;
    color: var(--text-secondary);
    font-style: italic;
    line-height: var(--text-body--line-height);
  }
  .cp-unsupported-item__note {
    margin: 0;
    font-size: var(--text-caption);
    color: var(--text-muted);
  }
</style>
