---
/**
 * Shop-disclosure module — CLAUDE.md §7 / design handoff §28/§30: "where
 * a compound discussed in Research is also sold in the Shop, that
 * relationship is a single explicit, separately-styled module — never an
 * inline mention." Terracotta-bordered (shop-mode color, §30), visually
 * separate from every evidence/safety/regulatory block.
 *
 * There is deliberately no real "sold in shop" signal wired up yet — no
 * FK exists (or should exist, per §15/§30's research/commerce
 * separation) from compounds to the not-yet-migrated commerce schema.
 * This component is only ever invoked from the dev-fixture profile path
 * today (see src/pages/research/compounds/[slug].astro) to demonstrate
 * the template; real compounds render nothing here until that
 * cross-reference is deliberately built and approved.
 */
interface Props {
  shopUrl: string;
}
const { shopUrl } = Astro.props;
---

<div class="cp-shop-disclosure">
  <p class="cp-shop-disclosure__title">
    <svg
      aria-hidden="true"
      viewBox="0 0 20 20"
      width="14"
      height="14"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="10" cy="10" r="7"></circle><path
        d="M10 13v.01M10 6.5a2 2 0 0 1 2 2c0 1.3-2 1.8-2 3.5"></path>
    </svg>
    Also sold in our shop
  </p>
  <p class="cp-shop-disclosure__body">
    Cloud Peptides sells this compound. This disclosure is separate from the evidence above —
    nothing on this page is a purchase recommendation.
  </p>
  <a class="cp-shop-disclosure__link" href={shopUrl}>View shop listing</a>
</div>

<style>
  .cp-shop-disclosure {
    /* --terracotta-text is only AA-verified (design handoff §15) against
       --bg, not --bg-sunken — axe caught 4.15:1 (below 4.5:1) when this
       used the sunken surface. --bg-elevated (white) keeps the intended
       terracotta-bordered "shop mode" look at a verified contrast. */
    border: 1.5px solid var(--terracotta-text);
    background: var(--bg-elevated);
    border-radius: var(--radius-card);
    padding: 1rem;
  }
  .cp-shop-disclosure__title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    color: var(--terracotta-text);
    font-size: var(--text-caption);
    margin: 0 0 0.4rem;
  }
  .cp-shop-disclosure__body {
    color: var(--text-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
    margin: 0 0 0.75rem;
  }
  .cp-shop-disclosure__link {
    display: block;
    text-align: center;
    width: 100%;
    padding: 0.5rem;
    border-radius: var(--radius-control);
    border: 1.5px solid var(--terracotta-text);
    color: var(--terracotta-text);
    text-decoration: none;
    font-size: var(--text-caption);
    font-weight: 500;
  }
</style>
