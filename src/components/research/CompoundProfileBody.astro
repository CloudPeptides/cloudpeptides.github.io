---
/**
 * The actual compound-profile content (identity card, claim sections,
 * evidence grid, regulatory records, sidebar) — extracted from
 * src/pages/research/compounds/[slug].astro (Research CMS gap-fill,
 * 2026-08-10) so the admin preview route
 * (src/pages/admin/compounds/[id]/preview.astro, "Preview unpublished
 * changes") can render the EXACT same template a real publish would
 * produce, rather than a second, drift-prone approximation. The public
 * page and the preview route each own their own <BaseLayout> (title/
 * description/noindex differ), and both pass this component the same
 * `compound` shape either way (getPublishedCompoundBySlug vs.
 * getCompoundForEdit both return CompoundWithRelations).
 *
 * Purely presentational plus its own derived-data computation — no
 * data fetching happens in here.
 */
import Badge from '../ui/Badge.astro';
import Card from '../ui/Card.astro';
import ClaimBlock from './ClaimBlock.astro';
import RegulatoryRow from './RegulatoryRow.astro';
import StudyCard from './StudyCard.astro';
import EvidenceGrid from './EvidenceGrid.astro';
import ShopDisclosure from './ShopDisclosure.astro';
import ExpertReviewWarning from './ExpertReviewWarning.astro';
import UnsupportedClaimsCard from './UnsupportedClaimsCard.astro';
import EmptyState from '../ui/EmptyState.astro';
import ErrorState from '../ui/ErrorState.astro';
import type { CompoundWithRelations, ContentSection } from '../../lib/database.types';
import type { RelatedCompound } from '../../lib/supabase';
import { partitionClaimsByDisposition } from '../../lib/reconciliation';
import { resolveEvidenceDisplayType } from '../../lib/evidence';

interface Props {
  compound: CompoundWithRelations | null;
  loadError: string | null;
  related: RelatedCompound[];
  isFixture?: boolean;
  emptyStateMessage?: string;
}
const {
  compound,
  loadError,
  related,
  isFixture = false,
  emptyStateMessage = "This compound doesn't exist, or isn't published yet.",
} = Astro.props;

const ENTITY_LABELS: Record<string, string> = {
  peptide: 'Peptide',
  peptide_blend: 'Peptide blend',
  stack: 'Stack',
  small_molecule_drug: 'Small molecule',
  biologic: 'Biologic',
  supplement: 'Supplement',
  non_peptide_research_compound: 'Research compound',
};

const SECTION_HEADINGS: Partial<Record<ContentSection, string>> = {
  summary: 'Overview',
  mechanism: 'Mechanism of Action',
  pharmacokinetics: 'Pharmacokinetics',
  origin: 'Origin',
  adverse_effects: 'Adverse Effects',
  interactions: 'Interactions',
  storage: 'Storage',
  faq: 'Frequently Asked Questions',
};

// 1.5px stroke, rounded caps/joins, 20px grid — design handoff §18.
// Content-specific per section — never the brand mark (§19).
const SECTION_ICONS: Partial<Record<ContentSection, string>> = {
  summary: '<path d="M8 3h4M8.5 3v5l-4 8a1.5 1.5 0 0 0 1.3 2.2h8.4A1.5 1.5 0 0 0 15.5 16l-4-8V3"/>',
  mechanism:
    '<circle cx="10" cy="10" r="2.2"/><path d="M10 3v2.2M10 14.8V17M17 10h-2.2M5.2 10H3M15.1 4.9l-1.5 1.5M6.4 13.6l-1.5 1.5M15.1 15.1l-1.5-1.5M6.4 6.4 4.9 4.9"/>',
  pharmacokinetics: '<path d="M4 10h3l2-5 4 10 2-5h3"/>',
  origin: '<circle cx="10" cy="7" r="4"/><path d="M6 17c0-2.5 1.8-4.5 4-4.5s4 2 4 4.5"/>',
  adverse_effects:
    '<path d="M10 3 4 5.5v4c0 4 2.6 7 6 8 3.4-1 6-4 6-8v-4L10 3Z"/><path d="M10 8v3.5M10 14v.01"/>',
  interactions: '<circle cx="6" cy="10" r="3"/><circle cx="14" cy="10" r="3"/>',
  storage: '<path d="M4 6h12v10H4z"/><path d="M4 6l1.5-3h9L16 6"/>',
  faq: '<circle cx="10" cy="10" r="7"/><path d="M10 13v.01M10 6.5a2 2 0 0 1 2 2c0 1.3-2 1.8-2 3.5"/>',
};
const SAFETY_ICON =
  '<path d="M10 3 4 5.5v4c0 4 2.6 7 6 8 3.4-1 6-4 6-8v-4L10 3Z"/><path d="M10 8v3.5M10 14v.01"/>';
const REGULATORY_ICON =
  '<path d="M10 3v14M4 6h3.5L5 12h5M16 6h-3.5L15 12h-5"/><path d="M4 17h12"/>';
const RELATED_ICON =
  '<circle cx="6" cy="6" r="2.5"/><circle cx="14" cy="14" r="2.5"/><path d="M8 8l4 4"/>';

type Claims = NonNullable<typeof compound>['claims'];

// Only ever render published claims — status is not filtered by the
// nested-select join itself (see src/lib/supabase.ts), so this is the
// one place both the real public page and the admin "preview unpublished
// changes" route (which reuses this same component) enforce it, keeping
// the two in sync. This is also what makes the 2026-08-11 disclaimer/
// site-policy claim cleanup (status='archived', see audit_log) actually
// disappear from public view rather than just no longer being counted.
const publishedClaims = compound ? compound.claims.filter((c) => c.status === 'published') : [];

// Phase 3 content-display rule: a claim reconciled as 'unsupported' (or,
// defensively, 'contradicted' — none currently exist in the database),
// or one whose only citation turned out to be the retired legacy site
// (not evidence — see src/lib/reconciliation.ts), must never appear in a
// normal content section as if it were an established, cited fact. Both
// are routed to a dedicated section instead (rendered near the end of
// the page) — see src/components/research/UnsupportedClaimsCard.astro.
const { visible: visibleClaims, unsupported: unsupportedClaims } =
  partitionClaimsByDisposition(publishedClaims);

const claimsBySection = new Map<ContentSection, Claims>();
for (const claim of visibleClaims) {
  const bucket = claimsBySection.get(claim.content_section) ?? [];
  bucket.push(claim);
  claimsBySection.set(claim.content_section, bucket);
}
for (const bucket of claimsBySection.values()) {
  bucket.sort((a, b) => (a.display_order ?? 0) - (b.display_order ?? 0));
}

type EvidenceGridType = 'human' | 'animal' | 'in-vitro' | 'mechanistic';

// Evidence-by-type counts are computed from VISIBLE claims only — an
// unsupported legacy claim's citations (when it has any at all; most
// have none) should never inflate the compound's apparent evidence base.
function evidenceGridCounts() {
  const counts: Record<EvidenceGridType, number> = {
    human: 0,
    animal: 0,
    'in-vitro': 0,
    mechanistic: 0,
  };
  for (const claim of visibleClaims) {
    for (const cs of claim.claim_sources) {
      const design = cs.sources.studies?.study_design ?? null;
      const type = resolveEvidenceDisplayType(cs.sources.source_type, design);
      if (type === 'human' || type === 'animal' || type === 'in-vitro' || type === 'mechanistic') {
        counts[type]++;
      }
    }
  }
  return counts;
}
const evidenceCounts = evidenceGridCounts();

// Unique sources across every VISIBLE claim, for the citation-cards
// section — same rationale as evidenceGridCounts above.
const allSources = [
  ...new Map(
    visibleClaims.flatMap((c) => c.claim_sources).map((cs) => [cs.sources.id, cs]),
  ).values(),
];

const safetyClaims = [
  ...(claimsBySection.get('safety') ?? []),
  ...(claimsBySection.get('adverse_effects') ?? []),
];

const reviewFlagReason = compound?.expert_review_flag_reason || undefined;
const displayName = compound ? compound.display_name || compound.name : undefined;

// Plain-language public introduction (2026-08-11) — Supabase-backed,
// admin-editable (src/pages/admin/compounds/[id].astro), never hardcoded
// here. Renders nothing if a compound has no overview content written
// yet, rather than empty boxes.
const hasOverview = Boolean(
  compound &&
  (compound.overview_what_it_is ||
    compound.overview_why_people_use_it ||
    compound.overview_research_summary ||
    compound.overview_bottom_line),
);
const OVERVIEW_ICON =
  '<path d="M10 3c-3.5 0-6.5 2.7-7.5 7 1 4.3 4 7 7.5 7s6.5-2.7 7.5-7c-1-4.3-4-7-7.5-7Z"/><circle cx="10" cy="10" r="2.3"/>';

// No blanket compound-level identity_confidence or research_review_
// status badge in the identity card below (2026-08-10 correction) —
// both fields remain in the database and admin dashboard, but a badge
// reading "unverified" for literally every compound (identity_
// confidence had never been promoted from its default for any of the
// 56) was a misleading blanket signal, and "Research reviewed" invited
// the same misreading the other way. A real, specific concern still
// surfaces here via reviewFlagReason's ExpertReviewWarning banner
// below and via UnsupportedClaimsCard further down — never via a
// generic per-field state badge.

// The enrichment pipeline's internal migration provenance
// (raw_import_metadata.enrichment_pilot — run date, sources/claims
// added, legacy-claim reconciliation counts) used to be surfaced here in
// a "Provenance" card. Removed 2026-08-11: it's CMS-migration history,
// not research content, and its "legacy claims reconciled" language was
// exactly the kind of public-facing legacy-site reference this page must
// not carry. The data itself is untouched in raw_import_metadata for
// internal use; it's simply no longer rendered on the public profile.

// Shop is now rebuilt natively in this app — no per-compound product-id
// mapping exists between compound slugs (e.g. "bpc-157") and shop
// product ids (e.g. "bpc"), so this links to the general shop entry
// point rather than guessing/inventing a specific product link.
const SHOP_URL = '/shop';
---

<section class="cp-research-container">
  {
    loadError && (
      <Fragment>
        <h1 class="cp-visually-hidden">Compound profile</h1>
        <ErrorState message={loadError} />
      </Fragment>
    )
  }

  {
    !loadError && !compound && (
      <EmptyState
        headingLevel="h1"
        title="Compound not found"
        message={emptyStateMessage}
        actionLabel="Back to the directory"
        actionHref="/research/compounds"
      />
    )
  }

  {
    !loadError && compound && (
      <Fragment>
        <nav class="cp-breadcrumb" aria-label="Breadcrumb">
          <a href="/research/compounds">Research</a>
          <span aria-hidden="true">/</span>
          {compound.category && (
            <Fragment>
              <span>{compound.category}</span>
              <span aria-hidden="true">/</span>
            </Fragment>
          )}
          <span aria-current="page">{displayName}</span>
        </nav>

        {reviewFlagReason && <ExpertReviewWarning reason={reviewFlagReason} />}

        <Card class="cp-identity-card">
          <div class="cp-identity-card__badges">
            <Badge tone={compound.entity_kind === 'stack' ? 'terracotta' : 'forest'}>
              {ENTITY_LABELS[compound.entity_kind] ?? compound.entity_kind}
            </Badge>
            {compound.category && <Badge tone="neutral">{compound.category}</Badge>}
          </div>
          <h1 class="cp-identity-card__name">{displayName}</h1>
          {compound.compound_aliases.length > 0 && (
            <p class="cp-identity-card__aliases">
              Also known as{' '}
              {compound.compound_aliases.map((a) => (
                <span class="cp-mono" title={a.note ?? undefined}>
                  {a.alias}
                  {a.alias_type === 'brand_name' && (
                    <span class="cp-identity-card__brand-tag"> (brand name)</span>
                  )}
                </span>
              ))}
            </p>
          )}
          <div class="cp-identity-card__strip">
            {compound.display_name && <span>Canonical name: {compound.name}</span>}
            <span>Entity: {ENTITY_LABELS[compound.entity_kind] ?? compound.entity_kind}</span>
            {compound.category && <span>Category: {compound.category}</span>}
            <span>Identifier: {compound.slug}</span>
          </div>
        </Card>

        {hasOverview && (
          <Card class="cp-overview-card">
            <h2 class="cp-section-heading">
              <svg
                aria-hidden="true"
                viewBox="0 0 20 20"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={OVERVIEW_ICON}
              />
              Overview
            </h2>
            {compound.overview_what_it_is && (
              <div class="cp-overview-block">
                <h3>What it is</h3>
                <p>{compound.overview_what_it_is}</p>
              </div>
            )}
            {compound.overview_why_people_use_it && (
              <div class="cp-overview-block">
                <h3>Why people look it up</h3>
                <p>{compound.overview_why_people_use_it}</p>
              </div>
            )}
            {compound.overview_research_summary && (
              <div class="cp-overview-block">
                <h3>What the research actually shows</h3>
                <p>{compound.overview_research_summary}</p>
                {compound.overview_evidence_reviewed_date && (
                  <p class="cp-overview-block__meta">
                    Evidence last reviewed{' '}
                    {new Date(compound.overview_evidence_reviewed_date).toLocaleDateString(
                      'en-US',
                      { year: 'numeric', month: 'long', day: 'numeric' },
                    )}
                  </p>
                )}
              </div>
            )}
            {compound.overview_bottom_line && (
              <div class="cp-overview-block cp-overview-block--bottom-line">
                <h3>Bottom line</h3>
                <p>{compound.overview_bottom_line}</p>
              </div>
            )}
          </Card>
        )}

        <div class="cp-profile-layout">
          <div class="cp-profile-main">
            {compound.entity_kind === 'stack' && compound.stack_components.length > 0 && (
              <Card class="cp-profile-section">
                <h2 class="cp-section-heading">Component Compounds</h2>
                <ul class="cp-related-list">
                  {compound.stack_components.map((sc) => (
                    <li>
                      <a href={`/research/compounds/${sc.compounds.slug}`}>{sc.compounds.name}</a>
                      {sc.dose_or_ratio_note && (
                        <span class="cp-mono"> — {sc.dose_or_ratio_note}</span>
                      )}
                    </li>
                  ))}
                </ul>
              </Card>
            )}

            {(['summary', 'mechanism', 'pharmacokinetics', 'origin'] as ContentSection[]).map(
              (section) =>
                claimsBySection.has(section) && (
                  <Card class="cp-profile-section">
                    <h2 class="cp-section-heading">
                      <svg
                        aria-hidden="true"
                        viewBox="0 0 20 20"
                        width="16"
                        height="16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        set:html={SECTION_ICONS[section]}
                      />
                      {SECTION_HEADINGS[section]}
                    </h2>
                    {claimsBySection.get(section)!.map((claim) => (
                      <ClaimBlock claim={claim} />
                    ))}
                  </Card>
                ),
            )}

            <Card class="cp-profile-section">
              <h2 class="cp-section-heading">
                <svg
                  aria-hidden="true"
                  viewBox="0 0 20 20"
                  width="16"
                  height="16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M4 10h3l2-5 4 10 2-5h3" />
                </svg>
                Evidence by Type
              </h2>
              <EvidenceGrid counts={evidenceCounts} />
            </Card>

            {safetyClaims.length > 0 && (
              <Card class="cp-profile-section cp-profile-section--safety">
                <h2 class="cp-section-heading cp-section-heading--danger">
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 20 20"
                    width="16"
                    height="16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={SAFETY_ICON}
                  />
                  Safety &amp; Uncertainty
                </h2>
                {safetyClaims.map((claim) => (
                  <ClaimBlock claim={claim} />
                ))}
              </Card>
            )}

            {compound.regulatory_records.length > 0 && (
              <Card class="cp-profile-section">
                <h2 class="cp-section-heading">
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 20 20"
                    width="16"
                    height="16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={REGULATORY_ICON}
                  />
                  Regulatory Status by Jurisdiction
                </h2>
                <div class="cp-regulatory-list">
                  {compound.regulatory_records.map((record) => (
                    <RegulatoryRow record={record} />
                  ))}
                </div>
              </Card>
            )}

            {(['interactions', 'storage'] as ContentSection[]).map(
              (section) =>
                claimsBySection.has(section) && (
                  <Card class="cp-profile-section">
                    <h2 class="cp-section-heading">
                      <svg
                        aria-hidden="true"
                        viewBox="0 0 20 20"
                        width="16"
                        height="16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        set:html={SECTION_ICONS[section]}
                      />
                      {SECTION_HEADINGS[section]}
                    </h2>
                    {claimsBySection.get(section)!.map((claim) => (
                      <ClaimBlock claim={claim} />
                    ))}
                  </Card>
                ),
            )}

            {claimsBySection.has('faq') && (
              <Card class="cp-profile-section">
                <h2 class="cp-section-heading">
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 20 20"
                    width="16"
                    height="16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={SECTION_ICONS.faq}
                  />
                  Frequently Asked Questions
                </h2>
                {claimsBySection.get('faq')!.map((claim) => (
                  <ClaimBlock claim={claim} />
                ))}
              </Card>
            )}

            <UnsupportedClaimsCard claims={unsupportedClaims} />
          </div>

          <div class="cp-profile-side">
            {allSources.length > 0 && (
              <Card class="cp-profile-section">
                <h2 class="cp-section-heading cp-section-heading--small">
                  Studies &amp; Citations
                </h2>
                <div class="cp-study-stack">
                  {allSources.map((cs) => (
                    <StudyCard
                      source={cs.sources}
                      study={cs.sources.studies}
                      relationship={cs.relationship}
                      dateAccessed={cs.date_accessed}
                    />
                  ))}
                </div>
              </Card>
            )}

            {related.length > 0 && (
              <Card class="cp-profile-section">
                <h2 class="cp-section-heading cp-section-heading--small">
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 20 20"
                    width="14"
                    height="14"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={RELATED_ICON}
                  />
                  Related
                </h2>
                <ul class="cp-related-list cp-related-list--compact">
                  {related.map((r) => (
                    <li>
                      <a href={`/research/compounds/${r.slug}`}>{r.name} →</a>
                    </li>
                  ))}
                </ul>
              </Card>
            )}

            {compound.last_reviewed_at && (
              <Card class="cp-profile-section cp-reviewed-card">
                <svg
                  aria-hidden="true"
                  viewBox="0 0 20 20"
                  width="14"
                  height="14"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 3.5h10a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-11a1 1 0 0 1 1-1Z" />
                  <path d="M7 8.5l1.8 1.8L13 6.5" />
                </svg>
                Last reviewed {new Date(compound.last_reviewed_at).toLocaleDateString()} by the
                editorial team
              </Card>
            )}

            {isFixture && <ShopDisclosure shopUrl={SHOP_URL} />}
          </div>
        </div>
      </Fragment>
    )
  }
</section>

<style>
  .cp-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .cp-research-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem;
  }
  .cp-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-caption);
    color: var(--text-muted);
    margin-bottom: 1rem;
  }
  .cp-breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .cp-breadcrumb a:hover {
    color: var(--primary);
    text-decoration: underline;
  }
  .cp-breadcrumb [aria-current='page'] {
    color: var(--text-secondary);
  }

  .cp-identity-card {
    margin-bottom: 1.5rem;
  }
  .cp-identity-card__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .cp-identity-card__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-h1);
    color: var(--text-primary);
    margin: 0 0 0.375rem;
  }
  .cp-identity-card__aliases {
    color: var(--text-secondary);
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin: 0;
  }
  .cp-identity-card__brand-tag {
    font-family: var(--font-body, inherit);
    font-style: normal;
    color: var(--text-muted);
    font-size: 0.75rem;
  }
  .cp-identity-card__strip {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-top: 0.875rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-data);
    color: var(--text-secondary);
  }

  .cp-mono {
    font-family: var(--font-mono);
    font-size: var(--text-data);
  }

  .cp-profile-layout {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .cp-profile-section {
    margin-bottom: 1.25rem;
  }
  .cp-section-heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-h3);
    color: var(--text-primary);
    margin: 0 0 1rem;
  }
  .cp-section-heading svg {
    color: var(--primary);
    flex-shrink: 0;
  }
  .cp-section-heading--small {
    font-size: 1.0625rem;
  }
  .cp-section-heading--danger {
    color: var(--danger-text);
  }
  .cp-section-heading--danger svg {
    color: var(--danger-text);
  }
  .cp-profile-section--safety {
    border-color: var(--danger-text);
    border-width: 1.5px;
  }

  .cp-regulatory-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .cp-related-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .cp-related-list a {
    color: var(--primary);
    font-weight: 500;
    text-decoration: none;
  }
  .cp-related-list a:hover {
    text-decoration: underline;
  }
  .cp-related-list--compact li {
    font-size: var(--text-caption);
  }
  .cp-study-stack {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .cp-reviewed-card {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: var(--text-caption);
  }
  .cp-reviewed-card :global(.cp-card__body) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
