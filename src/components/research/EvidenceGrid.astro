---
/**
 * Evidence-by-type grid — design handoff §28: "four cells (human/animal/
 * in-vitro/mechanistic), each stating its actual count — including an
 * honest 'none identified' where that's true." Visually matches
 * design-concepts/cloudpeptides_compound_profile_concept.html's 2x2
 * sunk-cell grid with a content-specific icon per cell.
 */
interface Props {
  counts: Record<'human' | 'animal' | 'in-vitro' | 'mechanistic', number>;
}
const { counts } = Astro.props;

const CELLS: { type: keyof Props['counts']; label: string; icon: string }[] = [
  {
    type: 'human',
    label: 'Human',
    icon: '<circle cx="10" cy="6" r="3"/><path d="M4 17c0-3.3 2.7-6 6-6s6 2.7 6 6"/>',
  },
  {
    type: 'animal',
    label: 'Animal',
    icon: '<circle cx="6" cy="6" r="1.6"/><circle cx="14" cy="6" r="1.6"/><circle cx="3.5" cy="10.5" r="1.6"/><circle cx="16.5" cy="10.5" r="1.6"/><path d="M10 10c-2.5 0-4.5 2-4.5 4.2 0 1.6 1.4 2.8 3 2.4.7-.2 1-.2 1.5-.2s.8 0 1.5.2c1.6.4 3-.8 3-2.4C14.5 12 12.5 10 10 10Z"/>',
  },
  {
    type: 'in-vitro',
    label: 'In-vitro',
    icon: '<path d="M8 3h4M8.5 3v5l-4 8a1.5 1.5 0 0 0 1.3 2.2h8.4A1.5 1.5 0 0 0 15.5 16l-4-8V3"/><path d="M6.5 13h7"/>',
  },
  {
    type: 'mechanistic',
    label: 'Mechanistic',
    icon: '<circle cx="10" cy="10" r="2.2"/><path d="M10 3v2.2M10 14.8V17M17 10h-2.2M5.2 10H3M15.1 4.9l-1.5 1.5M6.4 13.6l-1.5 1.5M15.1 15.1l-1.5-1.5M6.4 6.4 4.9 4.9"/>',
  },
];

function summary(type: keyof Props['counts']): string {
  const n = counts[type];
  if (n === 0) return 'None identified';
  return `${n} ${n === 1 ? 'source' : 'sources'}`;
}
---

<div class="cp-evidence-grid">
  {
    CELLS.map((cell) => (
      <div class="cp-evidence-grid__cell">
        <div class="cp-evidence-grid__cell-top">
          <svg
            aria-hidden="true"
            viewBox="0 0 20 20"
            width="14"
            height="14"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={cell.icon}
          />
          {cell.label}
        </div>
        <div class="cp-evidence-grid__value" data-empty={counts[cell.type] === 0 ? '' : undefined}>
          {summary(cell.type)}
        </div>
      </div>
    ))
  }
</div>

<style>
  .cp-evidence-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  .cp-evidence-grid__cell {
    background: var(--bg-sunken);
    border-radius: var(--radius-control);
    padding: 0.75rem 0.875rem;
  }
  .cp-evidence-grid__cell-top {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  .cp-evidence-grid__value {
    margin-top: 0.25rem;
    font-size: var(--text-caption);
    color: var(--text-primary);
    font-weight: 500;
  }
  .cp-evidence-grid__value[data-empty] {
    color: var(--text-muted);
    font-weight: 400;
    font-style: italic;
  }
</style>
