---
/**
 * Search/filter/sort layout for the compound directory — design handoff
 * §27, restyled to closely match
 * design-concepts/cloudpeptides_directory_concept.html: search bar with
 * icon, active-filter chips, a sidebar filter card (desktop) that
 * collapses to a toggleable panel (mobile), sort + result count above
 * the results slot.
 *
 * Phase 3: extends the original type/category/identity filters with
 * evidence-based filters (evidence type, evidence strength, human
 * evidence, regulatory status) and additional sort options (evidence
 * strength, study count, recently updated) — the data these depend on
 * (CompoundListItem's derived studyCount/hasHumanEvidence/
 * maxEvidenceQuality/regulatoryStatuses/evidenceTypes) comes from
 * src/lib/supabase.ts's listPublishedCompounds(). Underlying controls
 * are still plain <select> elements with data-filter-* attributes/change
 * events, read by src/scripts/compound-search.ts.
 */
import type { CompoundListItem } from '../../lib/supabase';
import {
  EVIDENCE_DISPLAY_LABELS,
  EVIDENCE_QUALITY_LABELS,
  type EvidenceDisplayType,
} from '../../lib/evidence';
import type { EvidenceQuality } from '../../lib/database.types';

interface Props {
  compounds: CompoundListItem[];
}
const { compounds } = Astro.props;

const ENTITY_LABELS: Record<string, string> = {
  peptide: 'Peptide',
  peptide_blend: 'Peptide blend',
  stack: 'Stack',
  small_molecule_drug: 'Small molecule',
  biologic: 'Biologic',
  supplement: 'Supplement',
  non_peptide_research_compound: 'Research compound',
};

const REGULATORY_STATUS_LABELS: Record<string, string> = {
  approved: 'Approved',
  not_approved: 'Not approved',
  withdrawn: 'Withdrawn',
  discontinued: 'Discontinued',
  investigational: 'Investigational',
  banned_in_sport: 'Banned in sport',
  scheduled_controlled_substance: 'Scheduled / controlled substance',
  unscheduled: 'Unscheduled',
  no_determination: 'No determination',
  other: 'Other',
};

// Compounds/Stacks tabs (2026-08-20, approved) — canonical DB
// classification only (entity_kind === 'stack'), never inferred from
// name text/word count/"+" signs. See src/scripts/compound-search.ts
// for the tab/filter/URL interplay this markup drives.
const stackCount = compounds.filter((c) => c.entity_kind === 'stack').length;
const compoundCount = compounds.length - stackCount;

const entityKinds = [...new Set(compounds.map((c) => c.entity_kind))].sort();
const categories = [
  ...new Set(compounds.map((c) => c.category).filter((c): c is string => Boolean(c))),
].sort();
const confidences = [...new Set(compounds.map((c) => c.identity_confidence))].sort();
const evidenceTypesPresent = [
  ...new Set(compounds.flatMap((c) => c.evidenceTypes)),
] as EvidenceDisplayType[];
evidenceTypesPresent.sort();
const evidenceStrengthsPresent = [
  ...new Set(
    compounds.map((c) => c.maxEvidenceQuality).filter((q): q is EvidenceQuality => Boolean(q)),
  ),
];
const EVIDENCE_QUALITY_ORDER: EvidenceQuality[] = [
  'high',
  'moderate',
  'low',
  'very_low',
  'not_assessed',
];
evidenceStrengthsPresent.sort(
  (a, b) => EVIDENCE_QUALITY_ORDER.indexOf(a) - EVIDENCE_QUALITY_ORDER.indexOf(b),
);
const regulatoryStatusesPresent = [
  ...new Set(compounds.flatMap((c) => c.regulatoryStatuses)),
].sort();
---

<div class="cp-search-filter-bar">
  <div class="cp-directory-search">
    <svg
      aria-hidden="true"
      viewBox="0 0 20 20"
      width="16"
      height="16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="9" cy="9" r="6"></circle><path d="M17 17l-4-4"></path>
    </svg>
    <label for="compound-search" class="cp-visually-hidden">Search compounds by name or alias</label
    >
    <input
      id="compound-search"
      type="search"
      placeholder="Search by name or alias…"
      data-compound-search
      autocomplete="off"
    />
    <span class="cp-directory-search__echo" data-search-echo aria-live="polite"></span>
  </div>

  <div class="cp-directory-chips" data-active-chips aria-live="polite"></div>

  <div class="cp-directory-tabs" role="tablist" aria-label="Research entries">
    <button
      type="button"
      role="tab"
      id="cp-tab-compounds"
      aria-selected="true"
      aria-controls="cp-compound-grid"
      tabindex="0"
      class="cp-directory-tab"
      data-tab="compounds"
    >
      Compounds
      <span class="cp-directory-tab__count" data-tab-count="compounds">
        {compoundCount}
      </span>
    </button>
    <button
      type="button"
      role="tab"
      id="cp-tab-stacks"
      aria-selected="false"
      aria-controls="cp-compound-grid"
      tabindex="-1"
      class="cp-directory-tab"
      data-tab="stacks"
    >
      Stacks
      <span class="cp-directory-tab__count" data-tab-count="stacks">
        {stackCount}
      </span>
    </button>
  </div>

  <div class="cp-directory-layout">
    <button
      type="button"
      class="cp-directory-filter-toggle"
      data-filter-toggle
      aria-expanded="false"
      aria-controls="cp-directory-sidebar"
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 20 20"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M4 6h12M7 10h6M9 14h2"></path>
      </svg>
      Filters
    </button>

    <!-- role="region" rather than <aside>/complementary: this is part of
         the primary search/filter interface, not supplementary content,
         and a bare <aside> here would nest a complementary landmark
         inside <main> (an a11y violation caught by axe's
         landmark-complementary-is-top-level rule during verification). -->
    <div
      class="cp-directory-sidebar"
      id="cp-directory-sidebar"
      data-sidebar
      role="region"
      aria-label="Filters"
    >
      <p class="cp-directory-sidebar__heading">Filters</p>

      <div class="cp-filter-group">
        <p class="cp-filter-group__label">Type</p>
        <select data-filter-entity-kind aria-label="Filter by type">
          <option value="">All types</option>
          {entityKinds.map((k) => <option value={k}>{ENTITY_LABELS[k] ?? k}</option>)}
        </select>
      </div>

      <div class="cp-filter-group">
        <p class="cp-filter-group__label">Category</p>
        <select data-filter-category aria-label="Filter by research category">
          <option value="">All categories</option>
          {categories.map((c) => <option value={c}>{c}</option>)}
        </select>
      </div>

      <div class="cp-filter-group">
        <p class="cp-filter-group__label">Identity status</p>
        <select data-filter-confidence aria-label="Filter by identity status">
          <option value="">All</option>
          {confidences.map((c) => <option value={c}>{c.replace(/_/g, ' ')}</option>)}
        </select>
      </div>

      <div class="cp-filter-group">
        <p class="cp-filter-group__label">Evidence type</p>
        <select data-filter-evidence-type aria-label="Filter by evidence type">
          <option value="">Any evidence type</option>
          {evidenceTypesPresent.map((t) => <option value={t}>{EVIDENCE_DISPLAY_LABELS[t]}</option>)}
        </select>
      </div>

      <div class="cp-filter-group">
        <p class="cp-filter-group__label">Evidence strength</p>
        <select data-filter-evidence-strength aria-label="Filter by strongest evidence quality">
          <option value="">Any strength</option>
          {
            evidenceStrengthsPresent.map((q) => (
              <option value={q}>{EVIDENCE_QUALITY_LABELS[q]}</option>
            ))
          }
        </select>
      </div>

      <div class="cp-filter-group">
        <p class="cp-filter-group__label">Human evidence</p>
        <select data-filter-human-evidence aria-label="Filter by presence of human evidence">
          <option value="">Any</option>
          <option value="yes">Has human evidence</option>
          <option value="no">No human evidence identified</option>
        </select>
      </div>

      <div class="cp-filter-group">
        <p class="cp-filter-group__label">Regulatory status</p>
        <select data-filter-regulatory-status aria-label="Filter by regulatory status">
          <option value="">Any status</option>
          {
            regulatoryStatusesPresent.map((s) => (
              <option value={s}>{REGULATORY_STATUS_LABELS[s] ?? s}</option>
            ))
          }
        </select>
      </div>

      <button type="button" data-clear-filters class="cp-search-filter-bar__clear">
        Clear filters
      </button>
    </div>

    <div class="cp-directory-main">
      <div class="cp-directory-toolbar">
        <p class="cp-search-filter-bar__count" data-result-count aria-live="polite">
          {compounds.length} compounds
        </p>
        <label class="cp-directory-sort">
          Sort
          <select data-sort>
            <option value="name-asc">Name (A–Z)</option>
            <option value="name-desc">Name (Z–A)</option>
            <option value="evidence-desc">Evidence strength (strongest first)</option>
            <option value="studies-desc">Study count (most first)</option>
            <option value="updated-desc">Recently updated</option>
          </select>
        </label>
      </div>

      <slot />

      <div class="cp-directory-pagination" data-pagination hidden>
        <button type="button" data-load-more class="cp-directory-pagination__button">
          Show more compounds
        </button>
        <p class="cp-directory-pagination__status" data-pagination-status aria-live="polite"></p>
      </div>
    </div>
  </div>
</div>

<script>
  import '../../scripts/compound-search.ts';
</script>

<style>
  .cp-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .cp-search-filter-bar {
    margin-bottom: 1.5rem;
  }

  .cp-directory-search {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    background: var(--bg-elevated);
    border: 1.5px solid var(--border-interactive);
    border-radius: var(--radius-control);
    padding: 0.75rem 1rem;
    margin-bottom: 0.75rem;
    color: var(--text-muted);
  }
  .cp-directory-search input {
    flex: 1;
    border: none;
    background: transparent;
    color: var(--text-primary);
    font-size: var(--text-body);
    font-family: var(--font-body);
    outline: none;
    min-width: 0;
  }
  .cp-directory-search__echo {
    font-size: var(--text-caption);
    color: var(--text-muted);
    white-space: nowrap;
  }
  .cp-directory-search__echo strong {
    color: var(--primary);
    font-weight: 600;
  }

  .cp-directory-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .cp-directory-chips:empty {
    display: none;
  }
  .cp-directory-chips :global(.cp-chip) {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    background: var(--accent-mint);
    color: var(--primary);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    border: none;
    cursor: pointer;
    font-family: var(--font-body);
  }
  .cp-directory-chips :global(.cp-chip svg) {
    width: 11px;
    height: 11px;
  }

  .cp-directory-filter-toggle {
    display: none;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 44px;
    margin-bottom: 0.75rem;
    padding: 0 1rem;
    border-radius: var(--radius-control);
    border: 1.5px solid var(--border-interactive);
    background: var(--bg-elevated);
    color: var(--text-primary);
    font-weight: 500;
    cursor: pointer;
  }

  .cp-directory-tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  .cp-directory-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0.5rem 1rem;
    border: none;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: var(--text-body);
    font-weight: 500;
    cursor: pointer;
    margin-bottom: -1px;
  }
  .cp-directory-tab:hover {
    color: var(--text-primary);
  }
  .cp-directory-tab:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
  .cp-directory-tab[aria-selected='true'] {
    color: var(--primary);
    border-bottom-color: var(--primary);
    font-weight: 600;
  }
  /* Stacks echo the terracotta accent stack cards already use
     (CompoundCard.astro's accent prop) once that tab is active —
     distinct from the forest/mint Compounds accent, matching
     CLAUDE.md §5's "keep Research and Shop/Stack modes visually
     distinct" spirit. */
  .cp-directory-tab[data-tab='stacks'][aria-selected='true'] {
    color: var(--terracotta-text);
    border-bottom-color: var(--terracotta-text);
  }
  .cp-directory-tab__count {
    font-size: var(--text-caption);
    font-weight: 500;
    color: var(--text-muted);
    background: var(--bg-sunken);
    border-radius: 999px;
    padding: 0.0625rem 0.5rem;
  }
  .cp-directory-tab[aria-selected='true'] .cp-directory-tab__count {
    color: inherit;
  }

  .cp-directory-layout {
    display: grid;
    grid-template-columns: 15rem 1fr;
    gap: 1.25rem;
    align-items: start;
  }

  .cp-directory-sidebar {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: 1rem;
  }
  .cp-directory-sidebar__heading {
    font-weight: 600;
    color: var(--text-primary);
    font-size: var(--text-caption);
    margin: 0 0 0.75rem;
  }
  .cp-filter-group {
    margin-bottom: 0.875rem;
  }
  .cp-filter-group__label {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin: 0 0 0.375rem;
  }
  .cp-filter-group select {
    width: 100%;
    padding: 0.5rem 0.625rem;
    border-radius: var(--radius-control);
    border: 1.5px solid var(--border-interactive);
    background: var(--bg-sunken);
    color: var(--text-primary);
    min-height: 40px;
    font-size: var(--text-caption);
  }
  .cp-search-filter-bar__clear {
    width: 100%;
    min-height: 40px;
    margin-top: 0.25rem;
    border-radius: var(--radius-control);
    border: 1.5px solid var(--border-interactive);
    background: transparent;
    color: var(--text-primary);
    cursor: pointer;
    font-size: var(--text-caption);
  }

  .cp-directory-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .cp-search-filter-bar__count {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-caption);
  }
  .cp-directory-sort {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-caption);
    color: var(--text-secondary);
    font-weight: 500;
  }
  .cp-directory-sort select {
    padding: 0.375rem 0.625rem;
    border-radius: var(--radius-control);
    border: 1.5px solid var(--border-interactive);
    background: var(--bg-sunken);
    color: var(--text-primary);
    min-height: 40px;
  }

  .cp-directory-pagination {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.75rem;
  }
  .cp-directory-pagination__button {
    min-height: 44px;
    padding: 0 1.5rem;
    border-radius: var(--radius-control);
    border: 1.5px solid var(--border-interactive);
    background: var(--bg-elevated);
    color: var(--text-primary);
    font-weight: 500;
    cursor: pointer;
  }
  .cp-directory-pagination__button:hover {
    border-color: var(--primary);
    color: var(--primary);
  }
  .cp-directory-pagination__status {
    margin: 0;
    font-size: var(--text-caption);
    color: var(--text-muted);
  }

  @media (max-width: 860px) {
    .cp-directory-layout {
      grid-template-columns: 1fr;
    }
    .cp-directory-filter-toggle {
      display: inline-flex;
    }
    .cp-directory-sidebar {
      display: none;
    }
    .cp-directory-sidebar[data-open] {
      display: block;
    }
  }
</style>
