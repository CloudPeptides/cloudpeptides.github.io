---
/**
 * Product detail — rebuild of legacy-site/product.html + js/product.js.
 * Batch 4 (2026-08-10): resolved on-demand by product_slug against the
 * canonical Supabase shop_products table (published rows only),
 * replacing the build-time getStaticPaths lookup against the static
 * src/lib/shop-products.ts array — so an admin price/detail edit is
 * live on the very next request, no rebuild/redeploy needed. Every
 * existing URL (/shop/<product-id>) is preserved exactly: product_slug
 * was seeded from shop-products.ts's own Product.id for all 87
 * migrated SKUs (see the Batch 4 migration report).
 */
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import ErrorState from '../../components/ui/ErrorState.astro';
import { getPublicShopProduct, hasSupabaseConfig } from '../../lib/public-shop';
import { formatMoney } from '../../lib/shop';
import { COMMERCE_ENABLED } from '../../lib/launch-config';

const { id } = Astro.params;

let product: Awaited<ReturnType<typeof getPublicShopProduct>> = null;
let loadError: string | null = null;
if (!hasSupabaseConfig()) {
  loadError = 'Shop is not configured in this environment.';
} else if (id && Astro.locals.session) {
  try {
    product = await getPublicShopProduct(id, Astro.locals.session.accessToken);
  } catch {
    loadError = 'Could not load this product right now.';
  }
}

// A slug that doesn't resolve to a *published* row 404s whether it
// never existed, was never given a product_slug, or is currently
// private/compliance_hold — same "no signal either way" posture as the
// research compound profile page.
if (!loadError && !product) {
  Astro.response.status = 404;
}

// Product + (Aggregate)Offer only — truthful fields alone: real name,
// real price range, no fabricated availability/rating/review (none of
// that data exists — CLAUDE.md: never invent inventory/reviews).
// Research-platform-first launch: the `offers` block itself is a
// purchasability claim (schema.org readers/crawlers reasonably treat a
// Product's presence of `offers` as "this can be bought"), so it's
// omitted entirely while commerce is disabled — the Product entity
// (name/category) stays as plain, honest catalog-preview description,
// but nothing here asserts an active offer to sell.
const structuredData: Record<string, unknown>[] = [];
if (product) {
  const prices = product.options.map((o) => o.price);
  const lowPrice = Math.min(...prices);
  const highPrice = Math.max(...prices);
  structuredData.push({
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: product.name,
    category: product.category,
    ...(COMMERCE_ENABLED
      ? product.options.length > 1
        ? {
            offers: {
              '@type': 'AggregateOffer',
              priceCurrency: 'USD',
              lowPrice,
              highPrice,
              offerCount: product.options.length,
            },
          }
        : {
            offers: {
              '@type': 'Offer',
              priceCurrency: 'USD',
              price: lowPrice,
            },
          }
      : {}),
  });
  structuredData.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: new URL('/', Astro.site).toString(),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Shop',
        item: new URL('/shop', Astro.site).toString(),
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: product.name,
        item: new URL(`/shop/${product.id}`, Astro.site).toString(),
      },
    ],
  });
}
---

<BaseLayout
  title={product ? product.name : 'Product not found'}
  description={product
    ? `${product.name} — 10 vial research kit, ${product.options.length} mg option${product.options.length === 1 ? '' : 's'} available. For laboratory research use only.`
    : 'This product could not be found.'}
  ogType="product"
  structuredData={structuredData}
  noindex={!product}
>
  <section class="cp-product-page-container">
    <nav class="cp-breadcrumb" aria-label="Breadcrumb">
      <a href="/shop">Shop</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{product ? product.name : 'Not found'}</span>
    </nav>

    {loadError && <ErrorState message={loadError} retryHref="/shop" />}

    {
      !loadError && !product && (
        <EmptyState
          title="Product not found"
          message="This product doesn't exist or isn't currently listed."
          actionLabel="Back to Shop"
          actionHref="/shop"
        />
      )
    }

    {
      product && (
        <div class="cp-product-page">
          <div class="cp-product-vial" aria-hidden="true">
            <svg viewBox="0 0 100 180" width="100%" height="100%">
              <rect
                x="30"
                y="20"
                width="40"
                height="140"
                rx="16"
                fill="none"
                stroke="var(--border-interactive)"
                stroke-width="2"
              />
              <rect
                x="38"
                y="6"
                width="24"
                height="20"
                rx="4"
                fill="none"
                stroke="var(--border-interactive)"
                stroke-width="2"
              />
            </svg>
          </div>

          <div class="cp-product-info">
            <h1 id="productName">{product.name}</h1>
            <p class="cp-product-note">
              Batch-produced peptides tested by JANOSHIK.
              <br />
              Supplied directly from the lab.
            </p>

            {!COMMERCE_ENABLED && (
              <p class="cp-coming-soon-banner">
                Coming soon — ordering is not yet available. Pricing shown below is informational
                only.
              </p>
            )}

            <div class="cp-selector">
              <label for="optionSelect">Select MG</label>
              <select id="optionSelect" data-option-select>
                {product.options.map((option, i) => (
                  <option value={i}>
                    {option.spec} • {option.count} vial kit • {formatMoney(option.price)}
                  </option>
                ))}
              </select>
              <div class="cp-detail-price" id="price" data-price>
                {formatMoney(product.options[0].price)}
              </div>
              <p id="codeLine" class="cp-disclaimer" data-code-line>
                Code: {product.options[0].code} • {product.category}
              </p>
              <button
                type="button"
                class="cp-btn-full"
                id="addToCart"
                data-add-to-cart
                disabled={!COMMERCE_ENABLED}
                aria-disabled={!COMMERCE_ENABLED}
              >
                {COMMERCE_ENABLED ? 'Add To Cart' : 'Coming Soon'}
              </button>
              {COMMERCE_ENABLED && (
                <p
                  class="cp-add-feedback"
                  data-add-feedback
                  role="status"
                  aria-live="polite"
                  hidden
                >
                  Added to cart.
                </p>
              )}
            </div>

            <p class="cp-disclaimer">
              Research use only. Not for human consumption. No peptide information or medical claims
              are provided on this page. See our <a href="/shop-terms">Shop Terms</a>.
            </p>
          </div>
        </div>
      )
    }
  </section>
</BaseLayout>

{
  /*
    Pre-existing bug found and fixed here while writing this batch's
    cart regression tests (not introduced by Batch 4 — reproduced
    identically on the currently-live staging deployment, pre-cutover):
    the previous `<script is:inline nonce=... define:vars=...>` bridge
    for window.__cpProduct got hoisted by Astro's bundler to just after
    `</html>`, silently dropping the `nonce` attribute in the process —
    the CSP (src/middleware.ts) then correctly blocked it as an
    un-nonced inline script, so "Add to Cart" never actually ran.
    A `type="application/json"` data island sidesteps the whole
    nonce/hoisting interaction: browsers never execute
    `application/json` script content, so it isn't subject to the
    script-src directive at all — no nonce needed, nothing to hoist.
  */
}

{
  /* Defense-in-depth escape of "</" so a product name/spec containing a
    literal script-closing sequence could never break out of this tag —
    values here are admin-authored/sanitized already, but this is a
    zero-cost safeguard regardless. */
}
<script
  is:inline
  type="application/json"
  id="cpProductData"
  set:html={JSON.stringify(product).replace(/<\//g, '<\\/')}
/>
<script>
  import '../../scripts/product-page.ts';
</script>

<style>
  .cp-product-page-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem;
  }
  .cp-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-caption);
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }
  .cp-breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .cp-breadcrumb a:hover {
    color: var(--terracotta-text);
    text-decoration: underline;
  }
  .cp-breadcrumb [aria-current='page'] {
    color: var(--text-secondary);
  }

  .cp-product-page {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 2.5rem;
    align-items: start;
  }
  .cp-product-vial {
    background: var(--bg-sunken);
    border-radius: var(--radius-card);
    padding: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 16rem;
  }
  .cp-product-info h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-h1);
    color: var(--text-primary);
    margin: 0 0 0.5rem;
  }
  .cp-product-note {
    color: var(--text-secondary);
    font-size: var(--text-caption);
    line-height: 1.5;
    margin: 0 0 1.5rem;
  }
  .cp-selector {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: 1.25rem;
    margin-bottom: 1.25rem;
  }
  .cp-selector label {
    display: block;
    font-size: var(--text-caption);
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 0.375rem;
  }
  .cp-selector select {
    width: 100%;
    padding: 0.625rem 0.75rem;
    border-radius: var(--radius-control);
    border: 1.5px solid var(--border-interactive);
    background: var(--bg-sunken);
    color: var(--text-primary);
    font-size: var(--text-body);
    min-height: 44px;
    margin-bottom: 0.75rem;
  }
  .cp-detail-price {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.75rem;
    color: var(--terracotta-text);
    margin-bottom: 0.375rem;
  }
  .cp-disclaimer {
    font-size: var(--text-caption);
    color: var(--text-muted);
    margin: 0.5rem 0;
  }
  /* Underlined always, not just on hover — axe's link-in-text-block rule
     needs a non-color distinguisher since this link sits in plain text. */
  .cp-disclaimer a {
    color: var(--terracotta-text);
    text-decoration: underline;
  }
  .cp-coming-soon-banner {
    font-size: var(--text-caption);
    font-weight: 500;
    color: var(--warning-text);
    background: var(--bg-sunken);
    border-left: 3px solid var(--warning-text);
    padding: 0.75rem 1rem;
    margin: 0 0 1.25rem;
  }
  .cp-btn-full {
    width: 100%;
    min-height: 48px;
    background: var(--terracotta-strong);
    color: var(--text-on-terracotta);
    border: none;
    border-radius: var(--radius-control);
    font-weight: 600;
    font-size: var(--text-body);
    cursor: pointer;
    margin-top: 0.5rem;
  }
  .cp-btn-full:hover {
    filter: brightness(0.94);
  }
  .cp-add-feedback {
    color: var(--success-text);
    font-size: var(--text-caption);
    font-weight: 500;
    margin: 0.625rem 0 0;
    text-align: center;
  }

  @media (max-width: 760px) {
    .cp-product-page {
      grid-template-columns: 1fr;
    }
  }
</style>
