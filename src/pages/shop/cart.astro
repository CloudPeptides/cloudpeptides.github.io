---
/**
 * Cart page — rebuild of legacy-site/cart.html + js/cart.js. Same
 * 2-kit minimum / $15 / free-at-3+ shipping rules (src/lib/shop.ts).
 * The checkout form posts to src/pages/api/checkout.ts (a server-side
 * Worker route calling Resend) instead of the legacy client-side
 * Web3Forms call, which embedded a public access key in browser JS.
 *
 * Commerce Activation phase (2026-08-08) — approved product decision:
 * this is an order *request* workflow, not payment processing. There
 * is no payment-method field anywhere on this page (removed along
 * with the legacy "$5 non-crypto processing fee" disclosure, which
 * implied payment collection that never actually happens here) —
 * submitting this form does not charge the customer, accept an order,
 * or reserve inventory; Cloud Peptides reviews the request and
 * contacts the customer manually afterward.
 *
 * Research-platform-first launch: while COMMERCE_ENABLED is false
 * (src/lib/launch-config.ts), this page never renders the interactive
 * cart/checkout markup at all — no cart-page.ts import, no localStorage
 * read, no <form> — only a static "coming soon" notice. This is
 * deliberately more than just disabling the submit button: even a
 * browser with items already sitting in `cp-shop-cart` localStorage
 * from before this phase (or from local testing) sees the same static
 * notice, never a live-looking cart it could try to check out from.
 * src/pages/api/checkout.ts's own hard gate is the real backstop
 * either way.
 *
 * `Astro.locals.indexable` (set by src/middleware.ts on every request
 * from the live hostname, same mechanism src/pages/api/checkout.ts
 * itself reuses for its email-subject labeling) drives the visible
 * "this is a test environment" banner below — true only on the real
 * production host, so staging/local always show it. This is the UI
 * half of the approved "the staging order form must be visibly
 * labeled as a test environment" requirement; the email-subject
 * prefix in checkout.ts is the other half.
 *
 * On-demand: matches the other interactive-state pages in this project
 * (directory, profile) for consistency.
 */
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { COMMERCE_ENABLED } from '../../lib/launch-config';

const isTestEnvironment = !Astro.locals.indexable;
---

<BaseLayout
  title="Cart"
  description="Review your Cloud Peptides order request before submitting."
  noindex
>
  <section class="cp-cart-container">
    <header class="cp-cart-header">
      <p class="cp-eyebrow cp-eyebrow--shop">Shop</p>
      <h1 class="cp-cart-header__heading">Your Cart</h1>
      <p class="cp-cart-header__intro">Review your order request before submitting.</p>
    </header>

    {
      !COMMERCE_ENABLED && (
        <div class="cp-cart-coming-soon">
          <h2>Ordering isn't available yet</h2>
          <p>
            Cloud Peptides is launching as a research platform first. The shop catalog is a preview
            — carts, checkout, and order requests are not active yet, and no order or payment
            information can be submitted at this time.
          </p>
          <a href="/shop" class="cp-btn-outline">
            Back to Shop
          </a>
        </div>
      )
    }

    {
      COMMERCE_ENABLED && isTestEnvironment && (
        <p class="cp-test-env-banner" role="status">
          <strong>Test environment.</strong> This is a staging deployment for visual/functional
          review — order requests submitted here are clearly marked as test submissions and are not
          real customer orders.
        </p>
      )
    }

    {
      COMMERCE_ENABLED && (
        <Fragment>
          <div id="cartItems" class="cp-cart-items" />

          <div id="cartEmptyPanel" class="cp-cart-empty" hidden>
            <h2>Your cart is empty</h2>
            <p>Browse the shop to add products to your cart.</p>
            <a href="/shop" class="cp-btn-outline">
              Shop Now
            </a>
          </div>

          <div class="cp-cart-total">
            <p class="cp-cart-rules">
              Minimum order: 2 kits.
              <br />
              $15 shipping on 2 kits.
              <br />
              FREE shipping on 3+ kits.
            </p>
            <div class="cp-cart-total__row">
              <span>Subtotal:</span> <span id="subtotal">$0.00</span>
            </div>
            <div class="cp-cart-total__row">
              <span>Shipping:</span> <span id="shipping">$0.00</span>
            </div>
            <div class="cp-cart-total__grand">
              <span>Total:</span> <span id="total">$0.00</span>
            </div>
          </div>

          <form id="checkoutForm" class="cp-checkout-form">
            <h2>Submit an order request</h2>

            <p class="cp-disclaimer">
              This submits an order <strong>request</strong> — it is not an accepted order or a
              completed purchase, and no payment is collected here or anywhere on this site. After
              we review your request, we will contact you directly to proceed. This is a
              research-supply order request, not a medical purchase or a scientific/commerce
              endorsement of any kind.
            </p>

            <div class="cp-honeypot" aria-hidden="true">
              <label for="checkoutHoneypot">Leave this field blank</label>
              <input
                id="checkoutHoneypot"
                name="website"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </div>

            <label for="customerName" class="cp-visually-hidden">
              Full name
            </label>
            <input id="customerName" name="name" required placeholder="Full Name" />

            <label for="customerEmail" class="cp-visually-hidden">
              Email
            </label>
            <input id="customerEmail" name="email" type="email" required placeholder="Email" />

            <label for="customerPhone" class="cp-visually-hidden">
              Phone (optional)
            </label>
            <input id="customerPhone" name="phone" placeholder="Phone (optional)" />

            <fieldset class="cp-address-fieldset">
              <legend>Shipping address</legend>

              <label for="addressLine1" class="cp-visually-hidden">
                Street address
              </label>
              <input id="addressLine1" name="addressLine1" required placeholder="Street address" />

              <label for="addressLine2" class="cp-visually-hidden">
                Apartment, suite, etc. (optional)
              </label>
              <input
                id="addressLine2"
                name="addressLine2"
                placeholder="Apartment, suite, etc. (optional)"
              />

              <div class="cp-address-row">
                <div>
                  <label for="addressCity" class="cp-visually-hidden">
                    City
                  </label>
                  <input id="addressCity" name="addressCity" required placeholder="City" />
                </div>
                <div>
                  <label for="addressRegion" class="cp-visually-hidden">
                    State / Province / Region
                  </label>
                  <input
                    id="addressRegion"
                    name="addressRegion"
                    required
                    placeholder="State/Region"
                  />
                </div>
              </div>
              <div class="cp-address-row">
                <div>
                  <label for="addressPostalCode" class="cp-visually-hidden">
                    Postal code
                  </label>
                  <input
                    id="addressPostalCode"
                    name="addressPostalCode"
                    required
                    placeholder="Postal Code"
                  />
                </div>
                <div>
                  <label for="addressCountry" class="cp-visually-hidden">
                    Country
                  </label>
                  <input id="addressCountry" name="addressCountry" required placeholder="Country" />
                </div>
              </div>
            </fieldset>

            <label for="customerNotes" class="cp-visually-hidden">
              Additional notes
            </label>
            <textarea id="customerNotes" name="notes" placeholder="Additional notes (optional)" />

            <label class="cp-checkbox-field">
              <input id="ageAttestation" name="ageAttestation" type="checkbox" required />
              <span>
                I confirm I am at least 18 years old and this order request is for laboratory
                research use only, not for human consumption.
              </span>
            </label>

            <label class="cp-checkbox-field">
              <input id="termsAccepted" name="termsAccepted" type="checkbox" required />
              <span>
                I have read and accept the{' '}
                <a href="/shop-terms" target="_blank">
                  Shop Terms
                </a>
                .
              </span>
            </label>

            <div class="cf-turnstile" data-turnstile />

            <p
              class="cp-form-message"
              data-tone="error"
              id="checkoutFormMessage"
              role="alert"
              hidden
            />

            <button id="submitOrder" class="cp-btn-full" type="submit">
              Submit order request
            </button>
          </form>

          <div id="successMessage" class="cp-cart-success" hidden>
            <h2>Order request received</h2>
            <p id="successMessageBody">
              Your order request has been received — it has not yet been accepted, and no payment
              has been taken. We will review it and contact you directly to proceed.
            </p>
            <a href="/" class="cp-btn-outline">
              Return Home
            </a>
          </div>
        </Fragment>
      )
    }
  </section>
</BaseLayout>

{
  COMMERCE_ENABLED && (
    <script>
      import '../../scripts/cart-page.ts'; import '../../scripts/turnstile-widget.ts';
    </script>
  )
}

<style>
  .cp-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .cp-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .cp-cart-container {
    max-width: 760px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem;
  }
  .cp-cart-header {
    margin-bottom: 2rem;
  }
  .cp-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.9375rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
  }
  .cp-eyebrow--shop {
    color: var(--terracotta-text);
  }
  .cp-cart-header__heading {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-primary);
    font-size: var(--text-h1);
    margin: 0 0 0.5rem;
  }
  .cp-cart-header__intro {
    color: var(--text-secondary);
    margin: 0;
  }

  .cp-test-env-banner {
    font-size: var(--text-caption);
    font-weight: 500;
    color: var(--warning-text);
    background: var(--bg-sunken);
    border-left: 3px solid var(--warning-text);
    padding: 0.75rem 1rem;
    margin: 0 0 1.5rem;
  }

  .cp-cart-coming-soon {
    text-align: center;
    padding: 3rem 1.5rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
  }
  .cp-cart-coming-soon h2 {
    font-family: var(--font-display);
    color: var(--text-primary);
    margin: 0 0 0.75rem;
  }
  .cp-cart-coming-soon p {
    color: var(--text-secondary);
    line-height: var(--text-body--line-height);
    max-width: 40ch;
    margin: 0 auto;
  }

  .cp-cart-items {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    margin-bottom: 1.5rem;
  }
  :global(.cp-cart-item) {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: 1rem 1.25rem;
  }
  :global(.cp-cart-item__info) {
    flex: 1;
  }
  :global(.cp-cart-item__name) {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 0.125rem;
  }
  :global(.cp-cart-item__spec) {
    font-size: var(--text-caption);
    color: var(--text-muted);
    margin: 0 0 0.125rem;
  }
  :global(.cp-cart-item__price) {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--text-secondary);
    margin: 0;
  }
  :global(.cp-cart-item__qty) {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  :global(.cp-cart-item__qty button) {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-control);
    border: 1.5px solid var(--border-interactive);
    background: transparent;
    color: var(--text-primary);
    cursor: pointer;
    font-size: 1rem;
  }
  :global(.cp-cart-item__remove) {
    border: none;
    background: transparent;
    color: var(--danger-text);
    font-size: var(--text-caption);
    cursor: pointer;
    text-decoration: underline;
  }

  .cp-cart-empty {
    /* --terracotta-text (used by .cp-btn-outline inside here) is only
       AA-verified against --bg, not --bg-sunken — same class of bug
       already caught once in ShopDisclosure.astro; --bg-elevated keeps
       the button's contrast at a verified ratio (confirmed via axe:
       0 violations after this change). */
    text-align: center;
    padding: 3rem 1.5rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    margin-bottom: 1.5rem;
  }
  .cp-cart-empty h2 {
    font-family: var(--font-display);
    color: var(--text-primary);
  }

  .cp-cart-total {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.5rem;
  }
  .cp-cart-rules {
    font-size: var(--text-caption);
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0 0 1rem;
  }
  .cp-cart-total__row {
    display: flex;
    justify-content: space-between;
    color: var(--text-secondary);
    padding: 0.25rem 0;
  }
  .cp-cart-total__grand {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.5rem;
    color: var(--text-primary);
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
  }

  .cp-checkout-form {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .cp-checkout-form h2 {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    color: var(--text-primary);
    margin: 0;
  }
  .cp-checkout-form input,
  .cp-checkout-form select,
  .cp-checkout-form textarea {
    width: 100%;
    padding: 0.625rem 0.75rem;
    border-radius: var(--radius-control);
    border: 1.5px solid var(--border-interactive);
    background: var(--bg-sunken);
    color: var(--text-primary);
    font-size: var(--text-body);
    font-family: var(--font-body);
    min-height: 44px;
    box-sizing: border-box;
  }
  .cp-checkout-form textarea {
    min-height: 6rem;
    resize: vertical;
  }
  .cp-address-fieldset {
    border: 1.5px solid var(--border-subtle);
    border-radius: var(--radius-control);
    padding: 0.875rem 0.875rem 0.25rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .cp-address-fieldset legend {
    font-size: var(--text-caption);
    font-weight: 600;
    color: var(--text-secondary);
    padding: 0 0.375rem;
  }
  .cp-address-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.625rem;
  }
  .cp-checkbox-field {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    font-size: var(--text-caption);
    color: var(--text-secondary);
    line-height: 1.5;
    cursor: pointer;
  }
  .cp-checkbox-field input {
    width: auto;
    min-height: auto;
    margin-top: 0.15rem;
    flex-shrink: 0;
  }
  .cp-checkbox-field a {
    color: var(--terracotta-text);
    text-decoration: underline;
  }
  .cp-disclaimer {
    font-size: var(--text-caption);
    color: var(--text-muted);
    margin: 0;
  }
  .cp-form-message {
    font-size: var(--text-caption);
    padding: 0.625rem 0.875rem;
    border-radius: var(--radius-control);
    margin: 0;
  }
  .cp-form-message[data-tone='error'] {
    background: var(--bg-sunken);
    color: var(--danger-text);
    border: 1px solid var(--danger-text);
  }
  .cp-btn-full {
    width: 100%;
    min-height: 48px;
    background: var(--terracotta-strong);
    color: var(--text-on-terracotta);
    border: none;
    border-radius: var(--radius-control);
    font-weight: 600;
    font-size: var(--text-body);
    cursor: pointer;
  }
  .cp-btn-full:hover {
    filter: brightness(0.94);
  }
  .cp-btn-full:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .cp-btn-outline {
    display: inline-block;
    padding: 0.625rem 1.25rem;
    border-radius: var(--radius-control);
    border: 1.5px solid var(--terracotta-text);
    color: var(--terracotta-text);
    text-decoration: none;
    font-weight: 500;
    margin-top: 0.5rem;
  }

  .cp-cart-success {
    /* Same --terracotta-text-on-sunken contrast issue as .cp-cart-empty
       above (its "Return Home" link is also .cp-btn-outline). */
    text-align: center;
    padding: 3rem 1.5rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
  }
  .cp-cart-success h2 {
    font-family: var(--font-display);
    color: var(--text-primary);
  }

  @media (max-width: 480px) {
    .cp-address-row {
      grid-template-columns: 1fr;
    }
  }
</style>
