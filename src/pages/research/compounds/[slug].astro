---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import Badge from '../../../components/ui/Badge.astro';
import Card from '../../../components/ui/Card.astro';
import ClaimBlock from '../../../components/research/ClaimBlock.astro';
import RegulatoryRow from '../../../components/research/RegulatoryRow.astro';
import StudyCard from '../../../components/research/StudyCard.astro';
import EvidenceGrid from '../../../components/research/EvidenceGrid.astro';
import ShopDisclosure from '../../../components/research/ShopDisclosure.astro';
import EmptyState from '../../../components/ui/EmptyState.astro';
import ErrorState from '../../../components/ui/ErrorState.astro';
import {
  hasSupabaseConfig,
  getPublishedCompoundBySlug,
  getRelatedCompounds,
  type RelatedCompound,
} from '../../../lib/supabase';
import { fixtureCompound, fixtureRelatedCompounds } from '../../../lib/fixtures';
import type { ContentSection } from '../../../lib/database.types';

const { slug } = Astro.params;

let compound: Awaited<ReturnType<typeof getPublishedCompoundBySlug>> = null;
let loadError: string | null = null;
let related: RelatedCompound[] = [];
let isFixture = false;

// Dev-only template preview using clearly-fictional fixture data (see
// src/lib/fixtures.ts) — gated on an explicit opt-in flag (never set in
// .env.local, CI, or any deployed environment — only ever exported
// ephemerally for a one-off local review server), never queries
// Supabase, never shows real (draft or otherwise) content. Deliberately
// NOT `import.meta.env.DEV`: verified live that `astro preview` (what
// the e2e/build verification suite actually runs) also evaluates DEV as
// true for this adapter's on-demand routes — an explicit flag is the
// only thing that reliably stays false in every built/served context
// unless someone deliberately opts in. This is how the fully-populated
// template layout gets verified without publishing anything or
// fabricating claims about a real compound.
if (import.meta.env.PUBLIC_ENABLE_DEV_FIXTURES === 'true' && slug === fixtureCompound.slug) {
  compound = fixtureCompound;
  related = fixtureRelatedCompounds;
  isFixture = true;
} else if (!hasSupabaseConfig()) {
  loadError = 'Compound profiles are not configured in this environment.';
} else if (slug) {
  try {
    compound = await getPublishedCompoundBySlug(slug);
    if (compound) related = await getRelatedCompounds(compound.id);
  } catch {
    loadError = 'Could not load this compound profile right now.';
  }
}

// A slug that doesn't resolve to a *published* row renders the same
// "not found" response whether the compound doesn't exist at all or
// exists only as a draft — anonymous visitors get no signal either way
// that draft content exists. This is the direct-URL leakage boundary.
if (!loadError && !compound) {
  Astro.response.status = 404;
}

const ENTITY_LABELS: Record<string, string> = {
  peptide: 'Peptide',
  peptide_blend: 'Peptide blend',
  stack: 'Stack',
  small_molecule_drug: 'Small molecule',
  biologic: 'Biologic',
  supplement: 'Supplement',
  non_peptide_research_compound: 'Research compound',
};

const SECTION_HEADINGS: Partial<Record<ContentSection, string>> = {
  summary: 'Overview',
  mechanism: 'Mechanism of Action',
  pharmacokinetics: 'Pharmacokinetics',
  origin: 'Origin',
  adverse_effects: 'Adverse Effects',
  interactions: 'Interactions',
  storage: 'Storage',
  faq: 'Frequently Asked Questions',
};

// 1.5px stroke, rounded caps/joins, 20px grid — design handoff §18.
// Content-specific per section — never the brand mark (§19).
const SECTION_ICONS: Partial<Record<ContentSection, string>> = {
  summary: '<path d="M8 3h4M8.5 3v5l-4 8a1.5 1.5 0 0 0 1.3 2.2h8.4A1.5 1.5 0 0 0 15.5 16l-4-8V3"/>',
  mechanism:
    '<circle cx="10" cy="10" r="2.2"/><path d="M10 3v2.2M10 14.8V17M17 10h-2.2M5.2 10H3M15.1 4.9l-1.5 1.5M6.4 13.6l-1.5 1.5M15.1 15.1l-1.5-1.5M6.4 6.4 4.9 4.9"/>',
  pharmacokinetics: '<path d="M4 10h3l2-5 4 10 2-5h3"/>',
  origin: '<circle cx="10" cy="7" r="4"/><path d="M6 17c0-2.5 1.8-4.5 4-4.5s4 2 4 4.5"/>',
  adverse_effects:
    '<path d="M10 3 4 5.5v4c0 4 2.6 7 6 8 3.4-1 6-4 6-8v-4L10 3Z"/><path d="M10 8v3.5M10 14v.01"/>',
  interactions: '<circle cx="6" cy="10" r="3"/><circle cx="14" cy="10" r="3"/>',
  storage: '<path d="M4 6h12v10H4z"/><path d="M4 6l1.5-3h9L16 6"/>',
  faq: '<circle cx="10" cy="10" r="7"/><path d="M10 13v.01M10 6.5a2 2 0 0 1 2 2c0 1.3-2 1.8-2 3.5"/>',
};
const SAFETY_ICON =
  '<path d="M10 3 4 5.5v4c0 4 2.6 7 6 8 3.4-1 6-4 6-8v-4L10 3Z"/><path d="M10 8v3.5M10 14v.01"/>';
const REGULATORY_ICON =
  '<path d="M10 3v14M4 6h3.5L5 12h5M16 6h-3.5L15 12h-5"/><path d="M4 17h12"/>';
const RELATED_ICON =
  '<circle cx="6" cy="6" r="2.5"/><circle cx="14" cy="14" r="2.5"/><path d="M8 8l4 4"/>';

type Claims = NonNullable<typeof compound>['claims'];
const claimsBySection = new Map<ContentSection, Claims>();
if (compound) {
  for (const claim of compound.claims) {
    const bucket = claimsBySection.get(claim.content_section) ?? [];
    bucket.push(claim);
    claimsBySection.set(claim.content_section, bucket);
  }
  for (const bucket of claimsBySection.values()) {
    bucket.sort((a, b) => (a.display_order ?? 0) - (b.display_order ?? 0));
  }
}

type EvidenceGridType = 'human' | 'animal' | 'in-vitro' | 'mechanistic';
const HUMAN_STUDY_DESIGNS = [
  'rct_human',
  'non_randomized_human_trial',
  'human_observational',
  'case_report_or_series',
];

// Mirrors EvidenceBadge's own resolveDisplayType — kept in sync manually
// since this is a small, stable rule set. study_design (from the
// joined studies row) is the real signal when present; source_type is
// only a fallback for sources with no study attached (true for every
// currently-migrated draft's provenance-only source).
function evidenceGridCounts() {
  const counts: Record<EvidenceGridType, number> = {
    human: 0,
    animal: 0,
    'in-vitro': 0,
    mechanistic: 0,
  };
  if (!compound) return counts;
  for (const claim of compound.claims) {
    for (const cs of claim.claim_sources) {
      const design = cs.sources.studies?.study_design;
      if (design) {
        if (HUMAN_STUDY_DESIGNS.includes(design)) counts.human++;
        else if (design === 'animal_study') counts.animal++;
        else if (design === 'in_vitro_study') counts['in-vitro']++;
        else if (design === 'mechanistic') counts.mechanistic++;
        continue;
      }
      if (cs.sources.source_type === 'clinicaltrials_gov') counts.human++;
    }
  }
  return counts;
}
const evidenceCounts = evidenceGridCounts();

// Unique sources across every claim, for the citation-cards section.
const allSources = compound
  ? [
      ...new Map(
        compound.claims.flatMap((c) => c.claim_sources).map((cs) => [cs.sources.id, cs]),
      ).values(),
    ]
  : [];

const safetyClaims = [
  ...(claimsBySection.get('safety') ?? []),
  ...(claimsBySection.get('adverse_effects') ?? []),
];

// Shop is now rebuilt natively in this app — no per-compound product-id
// mapping exists between compound slugs (e.g. "bpc-157") and shop
// product ids (e.g. "bpc"), so this links to the general shop entry
// point rather than guessing/inventing a specific product link.
const SHOP_URL = '/shop';

// Description built only from real fields already on the compound —
// never a fabricated scientific summary.
const profileDescription = compound
  ? `${compound.name} research profile — ${ENTITY_LABELS[compound.entity_kind] ?? compound.entity_kind}${compound.category ? `, ${compound.category}` : ''}, with claim-level citations and evidence-type breakdown.`
  : 'Compound profile not found.';

const breadcrumbJsonLd = compound
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: new URL('/', Astro.site).toString(),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Research',
          item: new URL('/research/compounds', Astro.site).toString(),
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: compound.name,
          item: new URL(`/research/compounds/${compound.slug}`, Astro.site).toString(),
        },
      ],
    }
  : undefined;
---

<BaseLayout
  title={compound?.name ?? 'Compound not found'}
  description={profileDescription}
  structuredData={breadcrumbJsonLd}
  noindex={!compound}
>
  <section class="cp-research-container">
    {
      loadError && (
        <Fragment>
          <h1 class="cp-visually-hidden">Compound profile</h1>
          <ErrorState message={loadError} />
        </Fragment>
      )
    }

    {
      !loadError && !compound && (
        <EmptyState
          headingLevel="h1"
          title="Compound not found"
          message="This compound doesn't exist, or isn't published yet."
          actionLabel="Back to the directory"
          actionHref="/research/compounds"
        />
      )
    }

    {
      !loadError && compound && (
        <Fragment>
          <nav class="cp-breadcrumb" aria-label="Breadcrumb">
            <a href="/research/compounds">Research</a>
            <span aria-hidden="true">/</span>
            {compound.category && (
              <Fragment>
                <span>{compound.category}</span>
                <span aria-hidden="true">/</span>
              </Fragment>
            )}
            <span aria-current="page">{compound.name}</span>
          </nav>

          <Card class="cp-identity-card">
            <div class="cp-identity-card__badges">
              <Badge tone={compound.entity_kind === 'stack' ? 'terracotta' : 'forest'}>
                {ENTITY_LABELS[compound.entity_kind] ?? compound.entity_kind}
              </Badge>
              {compound.category && <Badge tone="neutral">{compound.category}</Badge>}
              {compound.identity_confidence !== 'verified' && (
                <Badge tone="warning">
                  identity: {compound.identity_confidence.replace(/_/g, ' ')}
                </Badge>
              )}
            </div>
            <h1 class="cp-identity-card__name">{compound.name}</h1>
            {compound.compound_aliases.length > 0 && (
              <p class="cp-identity-card__aliases">
                Also known as{' '}
                {compound.compound_aliases.map((a) => (
                  <span class="cp-mono">{a.alias}</span>
                ))}
              </p>
            )}
            <div class="cp-identity-card__strip">
              <span>Entity: {ENTITY_LABELS[compound.entity_kind] ?? compound.entity_kind}</span>
              {compound.category && <span>Category: {compound.category}</span>}
              <span>Identifier: {compound.slug}</span>
            </div>
          </Card>

          <div class="cp-profile-layout">
            <div class="cp-profile-main">
              {compound.entity_kind === 'stack' && compound.stack_components.length > 0 && (
                <Card class="cp-profile-section">
                  <h2 class="cp-section-heading">Component Compounds</h2>
                  <ul class="cp-related-list">
                    {compound.stack_components.map((sc) => (
                      <li>
                        <a href={`/research/compounds/${sc.compounds.slug}`}>{sc.compounds.name}</a>
                        {sc.dose_or_ratio_note && (
                          <span class="cp-mono"> — {sc.dose_or_ratio_note}</span>
                        )}
                      </li>
                    ))}
                  </ul>
                </Card>
              )}

              {(['summary', 'mechanism', 'pharmacokinetics', 'origin'] as ContentSection[]).map(
                (section) =>
                  claimsBySection.has(section) && (
                    <Card class="cp-profile-section">
                      <h2 class="cp-section-heading">
                        <svg
                          aria-hidden="true"
                          viewBox="0 0 20 20"
                          width="16"
                          height="16"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          set:html={SECTION_ICONS[section]}
                        />
                        {SECTION_HEADINGS[section]}
                      </h2>
                      {claimsBySection.get(section)!.map((claim) => (
                        <ClaimBlock claim={claim} />
                      ))}
                    </Card>
                  ),
              )}

              <Card class="cp-profile-section">
                <h2 class="cp-section-heading">
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 20 20"
                    width="16"
                    height="16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M4 10h3l2-5 4 10 2-5h3" />
                  </svg>
                  Evidence by Type
                </h2>
                <EvidenceGrid counts={evidenceCounts} />
              </Card>

              {safetyClaims.length > 0 && (
                <Card class="cp-profile-section cp-profile-section--safety">
                  <h2 class="cp-section-heading cp-section-heading--danger">
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 20 20"
                      width="16"
                      height="16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      set:html={SAFETY_ICON}
                    />
                    Safety &amp; Uncertainty
                  </h2>
                  {safetyClaims.map((claim) => (
                    <ClaimBlock claim={claim} />
                  ))}
                </Card>
              )}

              {compound.regulatory_records.length > 0 && (
                <Card class="cp-profile-section">
                  <h2 class="cp-section-heading">
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 20 20"
                      width="16"
                      height="16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      set:html={REGULATORY_ICON}
                    />
                    Regulatory Status by Jurisdiction
                  </h2>
                  <div class="cp-regulatory-list">
                    {compound.regulatory_records.map((record) => (
                      <RegulatoryRow record={record} />
                    ))}
                  </div>
                </Card>
              )}

              {(['interactions', 'storage'] as ContentSection[]).map(
                (section) =>
                  claimsBySection.has(section) && (
                    <Card class="cp-profile-section">
                      <h2 class="cp-section-heading">
                        <svg
                          aria-hidden="true"
                          viewBox="0 0 20 20"
                          width="16"
                          height="16"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          set:html={SECTION_ICONS[section]}
                        />
                        {SECTION_HEADINGS[section]}
                      </h2>
                      {claimsBySection.get(section)!.map((claim) => (
                        <ClaimBlock claim={claim} />
                      ))}
                    </Card>
                  ),
              )}

              {claimsBySection.has('faq') && (
                <Card class="cp-profile-section">
                  <h2 class="cp-section-heading">
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 20 20"
                      width="16"
                      height="16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      set:html={SECTION_ICONS.faq}
                    />
                    Frequently Asked Questions
                  </h2>
                  {claimsBySection.get('faq')!.map((claim) => (
                    <ClaimBlock claim={claim} />
                  ))}
                </Card>
              )}
            </div>

            <div class="cp-profile-side">
              {allSources.length > 0 && (
                <Card class="cp-profile-section">
                  <h2 class="cp-section-heading cp-section-heading--small">
                    Studies &amp; Citations
                  </h2>
                  <div class="cp-study-stack">
                    {allSources.map((cs) => (
                      <StudyCard
                        source={cs.sources}
                        study={cs.sources.studies}
                        relationship={cs.relationship}
                        dateAccessed={cs.date_accessed}
                      />
                    ))}
                  </div>
                </Card>
              )}

              {related.length > 0 && (
                <Card class="cp-profile-section">
                  <h2 class="cp-section-heading cp-section-heading--small">
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 20 20"
                      width="14"
                      height="14"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      set:html={RELATED_ICON}
                    />
                    Related
                  </h2>
                  <ul class="cp-related-list cp-related-list--compact">
                    {related.map((r) => (
                      <li>
                        <a href={`/research/compounds/${r.slug}`}>{r.name} →</a>
                      </li>
                    ))}
                  </ul>
                </Card>
              )}

              {compound.last_reviewed_at && (
                <Card class="cp-profile-section cp-reviewed-card">
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 20 20"
                    width="14"
                    height="14"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M5 3.5h10a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-11a1 1 0 0 1 1-1Z" />
                    <path d="M7 8.5l1.8 1.8L13 6.5" />
                  </svg>
                  Last reviewed {new Date(compound.last_reviewed_at).toLocaleDateString()} by the
                  editorial team
                </Card>
              )}

              {isFixture && <ShopDisclosure shopUrl={SHOP_URL} />}
            </div>
          </div>
        </Fragment>
      )
    }
  </section>
</BaseLayout>

<style>
  .cp-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .cp-research-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem;
  }
  .cp-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-caption);
    color: var(--text-muted);
    margin-bottom: 1rem;
  }
  .cp-breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .cp-breadcrumb a:hover {
    color: var(--primary);
    text-decoration: underline;
  }
  .cp-breadcrumb [aria-current='page'] {
    color: var(--text-secondary);
  }

  .cp-identity-card {
    margin-bottom: 1.5rem;
  }
  .cp-identity-card__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .cp-identity-card__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-h1);
    color: var(--text-primary);
    margin: 0 0 0.375rem;
  }
  .cp-identity-card__aliases {
    color: var(--text-secondary);
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin: 0;
  }
  .cp-identity-card__strip {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-top: 0.875rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-data);
    color: var(--text-secondary);
  }

  .cp-mono {
    font-family: var(--font-mono);
    font-size: var(--text-data);
  }

  .cp-profile-layout {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .cp-profile-section {
    margin-bottom: 1.25rem;
  }
  .cp-section-heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-h3);
    color: var(--text-primary);
    margin: 0 0 1rem;
  }
  .cp-section-heading svg {
    color: var(--primary);
    flex-shrink: 0;
  }
  .cp-section-heading--small {
    font-size: 1.0625rem;
  }
  .cp-section-heading--danger {
    color: var(--danger-text);
  }
  .cp-section-heading--danger svg {
    color: var(--danger-text);
  }
  .cp-profile-section--safety {
    border-color: var(--danger-text);
    border-width: 1.5px;
  }

  .cp-regulatory-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .cp-related-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .cp-related-list a {
    color: var(--primary);
    font-weight: 500;
    text-decoration: none;
  }
  .cp-related-list a:hover {
    text-decoration: underline;
  }
  .cp-related-list--compact li {
    font-size: var(--text-caption);
  }
  .cp-study-stack {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .cp-reviewed-card {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: var(--text-caption);
  }
  .cp-reviewed-card :global(.cp-card__body) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .cp-reviewed-card svg {
    flex-shrink: 0;
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .cp-profile-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
