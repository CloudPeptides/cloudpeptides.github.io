---
// On-demand: this page reads live, changing data from Supabase — the
// one genuine reason to opt out of the static-first default (CLAUDE.md
// §4 / Phase 1A's "static-first, on-demand only for routes that need
// it" decision).
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import CompoundCard from '../../../components/research/CompoundCard.astro';
import SearchFilterBar from '../../../components/research/SearchFilterBar.astro';
import EmptyState from '../../../components/ui/EmptyState.astro';
import ErrorState from '../../../components/ui/ErrorState.astro';
import { hasSupabaseConfig, listPublishedCompounds } from '../../../lib/supabase';
import { fixtureListItems } from '../../../lib/fixtures';

let compounds: Awaited<ReturnType<typeof listPublishedCompounds>> = [];
let loadError: string | null = null;

if (import.meta.env.PUBLIC_ENABLE_DEV_FIXTURES === 'true') {
  // TEMPORARY, UNCOMMITTED, LOCAL-ONLY branch — shows the dev fixture list
  // instead of querying Supabase, purely so the populated UI can be
  // reviewed locally. Gated on an explicit opt-in flag (never set in
  // .env.local, CI, or any deployed environment — only ever exported
  // ephemerally for a one-off local review server), not
  // `import.meta.env.DEV`: verified live that `astro preview` (what the
  // e2e/build verification suite actually runs) also evaluates DEV as
  // true for this adapter's on-demand routes, which would have let
  // fixture content leak into what's supposed to be an honest,
  // real-Supabase-backed check. Do not commit this branch.
  compounds = fixtureListItems;
} else if (hasSupabaseConfig()) {
  try {
    compounds = await listPublishedCompounds();
  } catch {
    loadError = 'Could not load the compound directory right now.';
  }
} else {
  loadError = 'Compound directory is not configured in this environment.';
}

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Research',
      item: new URL('/research/compounds', Astro.site).toString(),
    },
  ],
};
---

<BaseLayout
  title="Compound Directory"
  description="Browse the Cloud Peptides research library of published compounds."
  structuredData={breadcrumbJsonLd}
>
  <section class="cp-research-container">
    <header class="cp-directory-header">
      <p class="cp-eyebrow">Research Library</p>
      <h1 class="cp-directory-header__heading">Compound Directory</h1>
      <p class="cp-directory-header__intro">
        Browse published research summaries, organized by type, category, and identity status. Every
        entry is claim-level cited and editorially reviewed before publication.
      </p>
    </header>

    {loadError && <ErrorState message={loadError} />}

    {
      !loadError && compounds.length === 0 && (
        <EmptyState
          title="No published compounds yet"
          message="The research library is still in editorial review. Published compound profiles will appear here once they clear the draft → in review → published workflow."
        />
      )
    }

    {
      !loadError && compounds.length > 0 && (
        <SearchFilterBar compounds={compounds}>
          <div class="cp-compound-grid" data-compound-grid>
            {compounds.map((compound) => (
              <div
                data-compound-item
                data-name={compound.name}
                data-entity-kind={compound.entity_kind}
                data-category={compound.category ?? ''}
                data-identity-confidence={compound.identity_confidence}
              >
                <CompoundCard compound={compound} />
              </div>
            ))}
          </div>
          <div data-filter-empty-state hidden>
            <EmptyState
              title="No compounds match those filters"
              message="Try a different search term or clear the filters to see everything published."
            />
          </div>
        </SearchFilterBar>
      )
    }
  </section>
</BaseLayout>

<style>
  .cp-research-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }
  .cp-directory-header {
    max-width: 42rem;
    margin-bottom: 2rem;
  }
  .cp-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--primary);
    margin: 0 0 0.5rem;
  }
  .cp-directory-header__heading {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-primary);
    font-size: clamp(1.875rem, 4vw, var(--text-h1));
    margin: 0 0 0.75rem;
  }
  .cp-directory-header__intro {
    color: var(--text-secondary);
    line-height: var(--text-body--line-height);
    margin: 0;
  }
  .cp-compound-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  @media (max-width: 1100px) {
    .cp-compound-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .cp-compound-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
