---
/**
 * Public researcher-account password-reset request — src/middleware.ts's
 * PUBLIC_ACCOUNT_PATHS entry, reachable while signed out.
 */
export const prerender = false;

import AccountLayout from '../layouts/AccountLayout.astro';
---

<AccountLayout title="Reset Your Password">
  <section class="cp-account-card">
    <h1>Reset your password</h1>
    <p class="cp-account-intro">
      Enter your account's email address and we'll send you a link to choose a new password.
    </p>

    <form id="forgotPasswordForm" class="cp-account-form">
      <label for="email">Email</label>
      <input type="email" name="email" id="email" required autocomplete="email" />

      <p class="cp-form-message" data-tone="error" id="forgotFormError" role="alert" hidden></p>

      <button class="cp-btn-full" type="submit" id="forgotSubmit">Send reset link</button>
    </form>

    <p class="cp-form-message" data-tone="success" id="forgotFormSuccess" role="status" hidden></p>

    <p class="cp-account-link"><a href="/login">&larr; Back to sign in</a></p>
  </section>
</AccountLayout>

<script>
  import '../scripts/account-forgot-password-form.ts';
</script>
