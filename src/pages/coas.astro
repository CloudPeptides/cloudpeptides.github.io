---
// On-demand: reads live, changing data from Supabase (published COAs
// can be added/unpublished at any time via /admin/coas) — same
// reasoning as src/pages/research/compounds/index.astro.
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/ui/Card.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import ErrorState from '../components/ui/ErrorState.astro';
import { getCoaFileUrl, hasSupabaseConfig, listPublishedCoas } from '../lib/coas';

let coas: Awaited<ReturnType<typeof listPublishedCoas>> = [];
let loadError: string | null = null;

if (hasSupabaseConfig()) {
  try {
    coas = await listPublishedCoas();
  } catch {
    loadError = 'Could not load the COA gallery right now.';
  }
} else {
  loadError = 'The COA gallery is not configured in this environment.';
}

const labs = [...new Set(coas.map((c) => c.testing_lab))].sort();

function fileKind(mime: string): 'pdf' | 'image' {
  return mime === 'application/pdf' ? 'pdf' : 'image';
}

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'COAs',
      item: new URL('/coas', Astro.site).toString(),
    },
  ],
};
---

<BaseLayout
  title="Certificates of Analysis"
  description="Batch testing documentation (Certificates of Analysis) for Cloud Peptides products."
  structuredData={breadcrumbJsonLd}
>
  <section class="cp-coas-container">
    <header class="cp-coas-header">
      <p class="cp-eyebrow cp-eyebrow--shop">Shop</p>
      <h1 class="cp-coas-header__heading">Certificates of Analysis</h1>
      <p class="cp-coas-header__intro">
        Batch testing documentation for applicable products, published as we receive it.
      </p>
      <p class="cp-coas-disclaimer">
        <strong>These are commerce/batch documentation, not scientific evidence.</strong> A COA verifies
        a specific batch's lab testing — it is never cited as evidence for, or otherwise linked to, any
        claim in our <a href="/research/compounds">research library</a>. See our
        <a href="/disclaimer">Research and Medical Disclaimer</a>.
      </p>
    </header>

    {loadError && <ErrorState message={loadError} retryHref="/coas" />}

    {
      !loadError && coas.length === 0 && (
        <EmptyState
          title="No published COAs yet"
          message="Batch testing documentation will appear here as it's published."
        />
      )
    }

    {
      !loadError && coas.length > 0 && (
        <Fragment>
          <div class="cp-coas-toolbar">
            <div class="cp-coas-search">
              <label for="coaSearch" class="cp-visually-hidden">
                Search by peptide name or batch number
              </label>
              <input
                id="coaSearch"
                type="search"
                placeholder="Search by peptide name or batch number…"
                data-coa-search
                autocomplete="off"
              />
            </div>
            {labs.length > 1 && (
              <label class="cp-coas-lab-filter">
                <span class="cp-visually-hidden">Filter by testing lab</span>
                <select data-coa-lab-filter>
                  <option value="all">All labs</option>
                  {labs.map((lab) => (
                    <option value={lab}>{lab}</option>
                  ))}
                </select>
              </label>
            )}
          </div>

          <div class="cp-coa-grid" data-coa-grid>
            {coas.map((coa) => (
              <div
                data-coa-item
                data-peptide={coa.peptide_name}
                data-batch={coa.batch_identifier ?? ''}
                data-lab={coa.testing_lab}
              >
                <Card class="cp-coa-card">
                  <h2 class="cp-coa-card__name">
                    {coa.peptide_name}
                    {coa.shop_products?.code && (
                      <span class="cp-coa-card__sku">{coa.shop_products.code}</span>
                    )}
                  </h2>
                  <dl class="cp-coa-card__meta">
                    {coa.batch_identifier && (
                      <div>
                        <dt>Batch</dt>
                        <dd>{coa.batch_identifier}</dd>
                      </div>
                    )}
                    <div>
                      <dt>Lab</dt>
                      <dd>{coa.testing_lab}</dd>
                    </div>
                    {coa.test_date && (
                      <div>
                        <dt>Test date</dt>
                        <dd>{new Date(coa.test_date).toLocaleDateString()}</dd>
                      </div>
                    )}
                    {coa.testing_method && (
                      <div>
                        <dt>Method</dt>
                        <dd>{coa.testing_method}</dd>
                      </div>
                    )}
                    {coa.purity_result && (
                      <div>
                        <dt>Purity</dt>
                        <dd>{coa.purity_result}</dd>
                      </div>
                    )}
                  </dl>
                  {coa.notes && <p class="cp-coa-card__notes">{coa.notes}</p>}
                  <div class="cp-coa-card__actions">
                    <a
                      href={getCoaFileUrl(coa.file_path)}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="cp-btn-outline"
                    >
                      View {fileKind(coa.file_mime_type) === 'pdf' ? 'PDF' : 'image'}
                    </a>
                    <a
                      href={getCoaFileUrl(coa.file_path)}
                      download={coa.original_filename}
                      class="cp-coa-card__download"
                    >
                      Download
                    </a>
                    {coa.verification_url && (
                      <a
                        href={coa.verification_url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="cp-coa-card__verify"
                      >
                        Verify independently
                      </a>
                    )}
                  </div>
                </Card>
              </div>
            ))}
          </div>
          <div data-coa-empty-state hidden>
            <EmptyState
              title="No COAs match your search"
              message="Try a different search term or clear the lab filter."
            />
          </div>
        </Fragment>
      )
    }
  </section>
</BaseLayout>

<script>
  import '../scripts/coa-search.ts';
</script>

<style>
  .cp-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .cp-coas-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }
  .cp-coas-header {
    max-width: 46rem;
    margin-bottom: 2rem;
  }
  .cp-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.9375rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
  }
  .cp-eyebrow--shop {
    color: var(--terracotta-text);
  }
  .cp-coas-header__heading {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-primary);
    font-size: clamp(1.875rem, 4vw, var(--text-h1));
    margin: 0 0 0.75rem;
  }
  .cp-coas-header__intro {
    color: var(--text-secondary);
    line-height: var(--text-body--line-height);
    margin: 0 0 1rem;
  }
  .cp-coas-disclaimer {
    font-size: var(--text-caption);
    color: var(--text-muted);
    background: var(--bg-sunken);
    border-left: 3px solid var(--terracotta-text);
    padding: 0.75rem 1rem;
    margin: 0;
  }
  .cp-coas-disclaimer a {
    color: var(--primary);
    text-decoration: underline;
  }

  .cp-coas-toolbar {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .cp-coas-search {
    flex: 1;
    min-width: 14rem;
    display: flex;
    align-items: center;
    background: var(--bg-elevated);
    border: 1.5px solid var(--border-interactive);
    border-radius: var(--radius-control);
    padding: 0.75rem 1rem;
  }
  .cp-coas-search input {
    flex: 1;
    border: none;
    background: transparent;
    color: var(--text-primary);
    font-size: var(--text-body);
    outline: none;
  }
  .cp-coas-lab-filter select {
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-control);
    border: 1.5px solid var(--border-interactive);
    background: var(--bg-elevated);
    color: var(--text-primary);
  }

  .cp-coa-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .cp-coa-card__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin: 0 0 0.75rem;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .cp-coa-card__sku {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-caption);
    color: var(--text-muted);
    background: var(--bg-sunken);
    border-radius: var(--radius-control);
    padding: 0.125rem 0.5rem;
  }
  .cp-coa-card__meta {
    display: grid;
    gap: 0.375rem;
    margin: 0 0 0.75rem;
  }
  .cp-coa-card__meta div {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: var(--text-caption);
  }
  .cp-coa-card__meta dt {
    color: var(--text-muted);
  }
  .cp-coa-card__meta dd {
    margin: 0;
    color: var(--text-secondary);
    font-weight: 500;
    text-align: right;
  }
  .cp-coa-card__notes {
    font-size: var(--text-caption);
    color: var(--text-secondary);
    margin: 0 0 0.75rem;
  }
  .cp-coa-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.875rem;
    align-items: center;
  }
  .cp-btn-outline {
    display: inline-block;
    padding: 0.5rem 1rem;
    min-height: 40px;
    border-radius: var(--radius-control);
    border: 1.5px solid var(--terracotta-text);
    color: var(--terracotta-text);
    text-decoration: none;
    font-weight: 500;
    font-size: var(--text-caption);
  }
  .cp-coa-card__download,
  .cp-coa-card__verify {
    color: var(--primary);
    font-size: var(--text-caption);
    text-decoration: underline;
  }

  @media (max-width: 1100px) {
    .cp-coa-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .cp-coa-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
