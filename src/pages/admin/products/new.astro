---
/**
 * "Add Product / Peptide" wizard — admin-only. Six logical steps:
 * (1) identity + duplicate check, (2) link-or-create research record,
 * (3+4 combined) shop product variants (one row is the base product,
 * "+ Add another variant" adds more — the same repeatable list covers
 * both), (5) blend/stack components, (6) review + transactional save.
 *
 * COA linking is deliberately NOT part of this wizard — a COA can only
 * be linked to a shop_products row that already has an id, and this
 * wizard's whole point is one atomic multi-table create. Linking an
 * existing COA to a newly created product is a one-field edit,
 * available from the product's own admin detail page (Batch 3).
 *
 * All writes happen through POST /api/admin/products, which calls the
 * transactional create_product_with_research() Postgres function —
 * this page only renders the form and the pre-fetched picker data
 * (categories, existing compounds).
 */
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createUserScopedClient, hasMinRole } from '../../../lib/auth';
import { ENTITY_KINDS, listCategories, listCompoundsForLinking } from '../../../lib/admin/products';

const session = Astro.locals.session!;
if (!hasMinRole(session.role, 'admin')) {
  return new Response('Admin access required.', { status: 403 });
}

const client = createUserScopedClient(session.accessToken);
let loadError: string | null = null;
let categories: Awaited<ReturnType<typeof listCategories>> = [];
let compounds: Awaited<ReturnType<typeof listCompoundsForLinking>> = [];
try {
  [categories, compounds] = await Promise.all([
    listCategories(client),
    listCompoundsForLinking(client),
  ]);
} catch {
  loadError = 'Could not load categories or compounds right now.';
}
---

<AdminLayout title="Add Product / Peptide">
  <div class="cp-admin-page-header">
    <div>
      <p class="cp-admin-eyebrow">Admin only</p>
      <h1>Add Product / Peptide</h1>
      <p>
        Creates a shop product and, optionally, its linked research record. New research records are
        always created as private drafts — nothing here is ever auto-published.
      </p>
    </div>
  </div>

  {
    loadError && (
      <p class="cp-admin-form-message" data-tone="error">
        {loadError}
      </p>
    )
  }

  {
    !loadError && (
      <form id="productWizard" class="cp-admin-form" novalidate>
        <input type="hidden" id="categoriesData" value={JSON.stringify(categories)} />
        <input type="hidden" id="compoundsData" value={JSON.stringify(compounds)} />
        <input type="hidden" id="entityKindsData" value={JSON.stringify(ENTITY_KINDS)} />

        <nav class="cp-wizard-steps" aria-label="Wizard steps">
          <ol>
            <li data-wizard-step-label="1" aria-current="step">
              1. Identity
            </li>
            <li data-wizard-step-label="2">2. Research record</li>
            <li data-wizard-step-label="3">3. Shop product(s)</li>
            <li data-wizard-step-label="5">4. Blend / stack</li>
            <li data-wizard-step-label="6">5. Review &amp; save</li>
          </ol>
        </nav>

        {/* --- Step 1: Identity --- */}
        <section data-wizard-step="1" class="cp-admin-section">
          <h2>Step 1 — Identity</h2>
          <div class="cp-admin-form-grid">
            <div class="cp-admin-field">
              <label for="canonicalName">
                Canonical name <span class="cp-admin-required">*</span>
              </label>
              <input id="canonicalName" required maxlength="200" />
            </div>
            <div class="cp-admin-field">
              <label for="displayName">Display name</label>
              <input id="displayName" maxlength="200" />
              <p class="cp-admin-field__hint">
                Optional — falls back to the canonical name if left blank.
              </p>
            </div>
            <div class="cp-admin-field">
              <label for="slug">
                Unique slug <span class="cp-admin-required">*</span>
              </label>
              <input id="slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*" maxlength="100" />
            </div>
            <div class="cp-admin-field">
              <label for="entityKind">
                Entity type <span class="cp-admin-required">*</span>
              </label>
              <select id="entityKind" required>
                {ENTITY_KINDS.map((k) => (
                  <option value={k.value}>{k.label}</option>
                ))}
              </select>
            </div>
          </div>

          <div class="cp-admin-field">
            <label id="aliasesLabel">Aliases</label>
            <div id="aliasesList" aria-labelledby="aliasesLabel" />
            <button
              type="button"
              class="cp-admin-btn cp-admin-btn--secondary cp-admin-btn--sm"
              id="addAliasBtn"
            >
              + Add alias
            </button>
          </div>

          <div id="duplicateResults" class="cp-wizard-duplicates" hidden>
            <p class="cp-admin-form-message" data-tone="warning">
              Possible existing matches — consider linking instead of creating a new record in Step
              2:
            </p>
            <ul id="duplicateList" />
          </div>
        </section>

        {/* --- Step 2: Research record --- */}
        <section data-wizard-step="2" class="cp-admin-section" hidden>
          <h2>Step 2 — Research record</h2>
          <div class="cp-admin-field">
            <label>
              <input type="radio" name="researchMode" value="new" checked /> Create a new draft
              research compound from Step 1
            </label>
            <label>
              <input type="radio" name="researchMode" value="link" /> Link to an existing research
              compound instead
            </label>
            <label>
              <input type="radio" name="researchMode" value="none" /> No research link —
              commerce-only product
            </label>
          </div>

          <div class="cp-admin-field" id="linkExistingField" hidden>
            <label for="existingCompoundSelect">Existing compound</label>
            <select id="existingCompoundSelect">
              <option value="">Select a compound…</option>
              {compounds.map((c) => (
                <option value={c.id} data-entity-kind={c.entity_kind}>
                  {c.display_name || c.name} ({c.entity_kind.replace(/_/g, ' ')}, {c.status})
                </option>
              ))}
            </select>
          </div>

          <p class="cp-admin-form-message" data-tone="warning" id="researchPendingNote">
            Research pending — this compound will remain a private draft, invisible on the public
            research directory, until it's enriched and explicitly published by an editor.
          </p>
        </section>

        {/* --- Step 3+4: Shop product variants --- */}
        <section data-wizard-step="3" class="cp-admin-section" hidden>
          <h2>Step 3 — Shop product(s)</h2>
          <p>
            Each row is one sellable SKU. Add another row for additional specifications of the same
            compound (e.g. CU50 and CU100 for the same GHK-Cu record).
          </p>
          <div id="variantsList" />
          <button type="button" class="cp-admin-btn cp-admin-btn--secondary" id="addVariantBtn">
            + Add another variant
          </button>
          <template id="variantTemplate">
            <div class="cp-admin-repeat-row" data-variant-row>
              <div class="cp-admin-repeat-row__main cp-admin-form-grid">
                <div class="cp-admin-field">
                  <label>
                    Product code / SKU <span class="cp-admin-required">*</span>
                  </label>
                  <input data-field="code" required maxlength="40" />
                </div>
                <div class="cp-admin-field">
                  <label>
                    Product name <span class="cp-admin-required">*</span>
                  </label>
                  <input data-field="name" required maxlength="200" />
                </div>
                <div class="cp-admin-field">
                  <label>
                    Specification <span class="cp-admin-required">*</span>
                  </label>
                  <input data-field="spec" required maxlength="100" placeholder="e.g. 50mg" />
                </div>
                <div class="cp-admin-field">
                  <label>
                    Vial / item count <span class="cp-admin-required">*</span>
                  </label>
                  <input data-field="count" type="number" min="1" step="1" required value="10" />
                </div>
                <div class="cp-admin-field">
                  <label>
                    Price (USD) <span class="cp-admin-required">*</span>
                  </label>
                  <input data-field="price" type="text" inputmode="decimal" required />
                  <p class="cp-admin-field__hint">
                    Customer-facing price only — no supplier cost field exists here.
                  </p>
                </div>
                <div class="cp-admin-field">
                  <label>
                    Category <span class="cp-admin-required">*</span>
                  </label>
                  <select data-field="categoryId" required>
                    <option value="">Select…</option>
                    {categories.map((c) => (
                      <option value={c.id}>{c.name}</option>
                    ))}
                  </select>
                </div>
                <div class="cp-admin-field">
                  <label>Internal status</label>
                  <select data-field="internalStatus">
                    <option value="draft">Draft</option>
                    <option value="active">Active</option>
                    <option value="archived">Archived</option>
                  </select>
                </div>
                <div class="cp-admin-field">
                  <label>Public-listing status</label>
                  <select data-field="publicStatus">
                    <option value="private">Private</option>
                    <option value="compliance_hold">Compliance hold</option>
                    <option value="published">Published</option>
                  </select>
                  <p class="cp-admin-field__hint">
                    Never defaults to published — you choose this explicitly.
                  </p>
                </div>
              </div>
              <button
                type="button"
                class="cp-admin-btn cp-admin-btn--danger cp-admin-btn--sm"
                data-remove-variant
              >
                Remove
              </button>
            </div>
          </template>
        </section>

        {/* --- Step 5: Blend / stack components --- */}
        <section data-wizard-step="5" class="cp-admin-section" hidden>
          <h2>Step 4 — Blend / stack components</h2>
          <p id="blendStepNote">
            Only relevant when the research record's entity type is "Blend" or "Stack". Select which
            <em>existing</em> research compounds this one is composed of — never creates duplicate
            compound records for the components.
          </p>
          <div id="blendComponentsList" class="cp-wizard-checklist" />
        </section>

        {/* --- Step 6: Review --- */}
        <section data-wizard-step="6" class="cp-admin-section" hidden>
          <h2>Step 5 — Review &amp; save</h2>
          <div id="reviewSummary" class="cp-wizard-review" />
          <p class="cp-admin-form-message" data-tone="error" id="wizardError" role="alert" hidden />
          <p
            class="cp-admin-form-message"
            data-tone="success"
            id="wizardSuccess"
            role="status"
            hidden
          />
        </section>

        <div class="cp-admin-form-actions">
          <button
            type="button"
            class="cp-admin-btn cp-admin-btn--secondary"
            id="wizardBackBtn"
            hidden
          >
            Back
          </button>
          <button type="button" class="cp-admin-btn cp-admin-btn--primary" id="wizardNextBtn">
            {' '}
            Next{' '}
          </button>
          <button
            type="button"
            class="cp-admin-btn cp-admin-btn--primary"
            id="wizardSaveBtn"
            hidden
          >
            Save
          </button>
        </div>
      </form>
    )
  }
</AdminLayout>

<script>
  import '../../../scripts/admin-product-wizard.ts';
</script>

<style>
  .cp-wizard-steps ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
  }
  .cp-wizard-steps li {
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    background: var(--bg-sunken);
    color: var(--text-secondary);
    font-size: var(--text-caption);
  }
  .cp-wizard-steps li[aria-current='step'] {
    background: var(--primary);
    color: var(--text-on-primary);
    font-weight: 600;
  }
  .cp-wizard-duplicates {
    margin-top: 1rem;
  }
  .cp-wizard-duplicates ul {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .cp-wizard-duplicates li {
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-control);
    background: var(--bg-sunken);
    font-size: var(--text-caption);
  }
  .cp-wizard-checklist {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    max-height: 20rem;
    overflow-y: auto;
    padding: 0.75rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-control);
  }
  .cp-wizard-review dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.375rem 1rem;
  }
  .cp-wizard-review dt {
    font-weight: 600;
    color: var(--text-secondary);
  }
  .cp-wizard-review ul {
    margin: 0;
    padding-left: 1.25rem;
  }
</style>
