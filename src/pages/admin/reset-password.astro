---
/**
 * Public admin password-reset completion page — the redirect target
 * Supabase's recovery email sends the browser to (src/lib/
 * password-reset.ts's buildResetRedirectUrl). Reachable while signed
 * out, same as /admin/login and /admin/forgot-password
 * (src/middleware.ts's PUBLIC_ADMIN_PATHS). The server can't know
 * ahead of render whether the link is valid — that only resolves
 * client-side once src/scripts/admin-reset-password-form.ts inspects
 * the URL — so all three states (form / expired / success) render in
 * the markup and the script toggles which is visible.
 */
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Choose a New Password" noindex hideChrome>
  <section class="cp-login-container">
    <div class="cp-login-card">
      <h1>Choose a new password</h1>
      <p class="cp-login-intro">Enter and confirm a new password for your admin account.</p>

      <form id="resetPasswordForm" class="cp-login-form">
        <label for="newPassword">New password</label>
        <input
          type="password"
          name="newPassword"
          id="newPassword"
          required
          autocomplete="new-password"
        />

        <label for="confirmPassword">Confirm new password</label>
        <input
          type="password"
          name="confirmPassword"
          id="confirmPassword"
          required
          autocomplete="new-password"
        />
        <p class="cp-field-hint">Must be at least 8 characters.</p>

        <p class="cp-form-message" data-tone="error" id="resetFormError" role="alert" hidden></p>

        <button class="cp-btn-full" type="submit" id="resetSubmit">Update password</button>
      </form>

      <div id="resetExpiredState" class="cp-login-state" hidden>
        <p class="cp-form-message" data-tone="error" role="alert">
          This password reset link is invalid or has expired.
        </p>
        <a class="cp-btn-full cp-btn-link" href="/admin/forgot-password">Request a new link</a>
      </div>

      <div id="resetSuccessState" class="cp-login-state" hidden>
        <p class="cp-form-message" data-tone="success" role="status">
          Your password has been updated. Redirecting you to sign in…
        </p>
      </div>

      <p class="cp-login-back"><a href="/admin/login">&larr; Back to sign in</a></p>
    </div>
  </section>
</BaseLayout>

<script>
  import '../../scripts/admin-reset-password-form.ts';
</script>

<style>
  .cp-login-container {
    min-height: calc(100vh - 4rem);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
  }
  .cp-login-card {
    width: 100%;
    max-width: 24rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: 2rem;
    box-shadow: var(--shadow-resting);
  }
  .cp-login-card h1 {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    color: var(--text-primary);
    margin: 0 0 0.375rem;
  }
  .cp-login-intro {
    color: var(--text-secondary);
    margin: 0 0 1.5rem;
    font-size: var(--text-caption);
  }
  .cp-login-form {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .cp-login-form label {
    font-size: var(--text-caption);
    font-weight: 500;
    color: var(--text-secondary);
    margin-top: 0.625rem;
  }
  .cp-login-form label:first-child {
    margin-top: 0;
  }
  .cp-login-form input {
    width: 100%;
    padding: 0.625rem 0.75rem;
    border-radius: var(--radius-control);
    border: 1.5px solid var(--border-interactive);
    background: var(--bg-sunken);
    color: var(--text-primary);
    font-size: var(--text-body);
    font-family: var(--font-body);
    min-height: 44px;
    box-sizing: border-box;
  }
  .cp-field-hint {
    font-size: var(--text-caption);
    color: var(--text-secondary);
    margin: 0.25rem 0 0;
  }
  .cp-form-message {
    font-size: var(--text-caption);
    padding: 0.625rem 0.875rem;
    border-radius: var(--radius-control);
    margin: 0.875rem 0 0;
  }
  .cp-form-message[data-tone='error'] {
    background: var(--bg-sunken);
    color: var(--danger-text);
    border: 1px solid var(--danger-text);
  }
  .cp-form-message[data-tone='success'] {
    background: var(--bg-sunken);
    color: var(--success-text);
    border: 1px solid var(--success-text);
  }
  .cp-btn-full {
    width: 100%;
    min-height: 48px;
    margin-top: 1.25rem;
    background: var(--primary);
    color: var(--text-on-primary);
    border: none;
    border-radius: var(--radius-control);
    font-weight: 600;
    font-size: var(--text-body);
    cursor: pointer;
    text-align: center;
    box-sizing: border-box;
  }
  .cp-btn-full:hover {
    background: var(--primary-hover);
  }
  .cp-btn-full:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .cp-btn-link {
    display: block;
    text-decoration: none;
    line-height: 48px;
  }
  .cp-login-state {
    margin-top: 0.5rem;
  }
  .cp-login-back {
    margin: 1.25rem 0 0;
    text-align: center;
    font-size: var(--text-caption);
  }
  .cp-login-back a {
    color: var(--text-secondary);
    text-decoration: underline;
  }
</style>
