---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import Pagination from '../../../components/admin/Pagination.astro';
import Badge from '../../../components/ui/Badge.astro';
import ErrorState from '../../../components/ui/ErrorState.astro';
import { createUserScopedClient } from '../../../lib/auth';
import { listSourcesForAdmin } from '../../../lib/admin/queries';

const session = Astro.locals.session!;
const client = createUserScopedClient(session.accessToken);

const params = Astro.url.searchParams;
const q = params.get('q') ?? '';
const page = Math.max(1, Number(params.get('page') ?? '1') || 1);
const PAGE_SIZE = 25;

let loadError: string | null = null;
let rows: Awaited<ReturnType<typeof listSourcesForAdmin>>['rows'] = [];
let total = 0;
try {
  const result = await listSourcesForAdmin(client, {
    q: q || undefined,
    page,
    pageSize: PAGE_SIZE,
  });
  rows = result.rows;
  total = result.total;
} catch {
  loadError = 'Could not load the sources library right now.';
}
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
---

<AdminLayout title="Sources">
  <div class="cp-admin-page-header">
    <div>
      <p class="cp-admin-eyebrow">Editorial</p>
      <h1>Sources</h1>
      <p>The citation library used across every claim and regulatory record.</p>
    </div>
    <a href="/admin/sources/new" class="cp-admin-btn cp-admin-btn--primary">+ New source</a>
  </div>

  <form method="get" class="cp-admin-toolbar">
    <input
      type="search"
      name="q"
      placeholder="Search by title or URL…"
      value={q}
      aria-label="Search sources"
    />
    <button type="submit" class="cp-admin-btn cp-admin-btn--secondary">Apply</button>
    <span class="cp-admin-toolbar__spacer"></span>
    <span class="cp-admin-toolbar__count">{total} source{total === 1 ? '' : 's'}</span>
  </form>

  {loadError && <ErrorState message={loadError} retryHref="/admin/sources" />}

  {
    !loadError && rows.length === 0 && (
      <div class="cp-admin-section">
        <p class="cp-admin-empty-row">No sources match that search.</p>
      </div>
    )
  }

  {
    !loadError && rows.length > 0 && (
      <div class="cp-admin-table-wrap">
        <table class="cp-admin-table">
          <thead>
            <tr>
              <th>Title</th>
              <th>Type</th>
              <th>Retraction status</th>
              <th>Published</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((s) => (
              <tr>
                <td>
                  <a href={`/admin/sources/${s.id}`}>{s.title}</a>
                </td>
                <td>{s.source_type.replace(/_/g, ' ')}</td>
                <td>
                  {s.retraction_status === 'none' ? (
                    s.retraction_status
                  ) : (
                    <Badge tone="danger">{s.retraction_status.replace(/_/g, ' ')}</Badge>
                  )}
                </td>
                <td>{s.publication_date ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  <Pagination currentUrl={Astro.url} page={page} totalPages={totalPages} />
</AdminLayout>
