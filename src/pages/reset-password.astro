---
/**
 * Public researcher-account password-reset completion — the redirect
 * target Supabase's recovery email sends the browser to
 * (src/lib/password-reset.ts's buildAccountResetRedirectUrl). Reachable
 * while signed out (src/middleware.ts's PUBLIC_ACCOUNT_PATHS).
 */
export const prerender = false;

import AccountLayout from '../layouts/AccountLayout.astro';
---

<AccountLayout title="Choose a New Password">
  <section class="cp-account-card">
    <h1>Choose a new password</h1>
    <p class="cp-account-intro">Enter and confirm a new password for your account.</p>

    <form id="resetPasswordForm" class="cp-account-form">
      <label for="newPassword">New password</label>
      <div class="cp-password-field">
        <input
          type="password"
          name="newPassword"
          id="newPassword"
          required
          minlength="8"
          autocomplete="new-password"
        />
        <button type="button" data-password-toggle data-target="newPassword" aria-pressed="false"
          >Show</button
        >
      </div>

      <label for="confirmPassword">Confirm new password</label>
      <div class="cp-password-field">
        <input
          type="password"
          name="confirmPassword"
          id="confirmPassword"
          required
          minlength="8"
          autocomplete="new-password"
        />
        <button
          type="button"
          data-password-toggle
          data-target="confirmPassword"
          aria-pressed="false"
        >
          Show
        </button>
      </div>

      <p class="cp-form-message" data-tone="error" id="resetFormError" role="alert" hidden></p>

      <button class="cp-btn-full" type="submit" id="resetSubmit">Update password</button>
    </form>

    <div id="resetExpiredState" hidden>
      <p class="cp-form-message" data-tone="error" role="alert">
        This password reset link is invalid or has expired.
      </p>
      <a class="cp-btn-full" href="/forgot-password">Request a new link</a>
    </div>

    <div id="resetSuccessState" hidden>
      <p class="cp-form-message" data-tone="success" role="status">
        Your password has been updated. Redirecting you to sign in…
      </p>
    </div>

    <p class="cp-account-link"><a href="/login">&larr; Back to sign in</a></p>
  </section>
</AccountLayout>

<script>
  import '../scripts/password-toggle.ts';
  import '../scripts/account-reset-password-form.ts';
</script>
